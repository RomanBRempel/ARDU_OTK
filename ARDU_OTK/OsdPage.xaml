<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ARDU_OTK.OsdPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ARDU_OTK"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>

        <!--
            Строка панели. Колонки постоянной ширины: оператор читает таблицу по
            вертикали — столбик включений отвечает на вопрос «что вообще
            рисуется», столбики X и Y — «не съехала ли раскладка». Колонка «по
            содержимому» схлопывается на коротких значениях, столбик перестаёт
            быть столбиком, и читать приходится каждую строку целиком.
        -->
        <DataTemplate x:Key="OsdPanelTemplate" x:DataType="local:OsdPanelRow">
            <Grid ColumnSpacing="8" Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Width="14" VerticalAlignment="Center">
                    <FontIcon
                        FontSize="{ThemeResource AppTinyFontSize}"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind MatchVisibility}" />
                    <FontIcon
                        FontSize="{ThemeResource AppTinyFontSize}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xEA39;"
                        Visibility="{x:Bind DiffVisibility}" />
                    <!--
                        Расхождение вне контроля: тот же значок, но приглушённый.
                        Оно не дефект — эталон это имя не сверяет, — но и не
                        совпадение, и выдать его за совпадение нельзя.
                    -->
                    <FontIcon
                        FontSize="{ThemeResource AppTinyFontSize}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE7BA;"
                        Visibility="{x:Bind UncontrolledVisibility}" />
                </Grid>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource AppCaptionTextStyle}"
                    Text="{x:Bind Caption}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Tip}" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Style="{StaticResource AppCaptionTextStyle}"
                    Text="{x:Bind EnableText}" />

                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Style="{StaticResource AppCaptionTextStyle}"
                    Text="{x:Bind ColumnText}"
                    TextAlignment="Right" />

                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Style="{StaticResource AppCaptionTextStyle}"
                    Text="{x:Bind RowText}"
                    TextAlignment="Right" />

                <!--
                    Эталон уходит второй строкой — поправкой к увиденному, а не
                    вторым столбиком чисел: на совпавшей панели он повторял бы
                    то же самое трижды, и настоящее расхождение терялось бы
                    среди заведомо одинакового.
                -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="4"
                    FontFamily="Consolas"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource AppCaptionTextStyle}"
                    Text="{x:Bind ReferenceLineText}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind ReferenceLineVisibility}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OsdValueTemplate" x:DataType="local:OsdValueRow">
            <Grid ColumnSpacing="8" Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="80" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Width="14" VerticalAlignment="Center">
                    <FontIcon
                        FontSize="{ThemeResource AppTinyFontSize}"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind MatchVisibility}" />
                    <FontIcon
                        FontSize="{ThemeResource AppTinyFontSize}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xEA39;"
                        Visibility="{x:Bind DiffVisibility}" />
                    <FontIcon
                        FontSize="{ThemeResource AppTinyFontSize}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE7BA;"
                        Visibility="{x:Bind UncontrolledVisibility}" />
                </Grid>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource AppCaptionTextStyle}"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Tip}" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Style="{StaticResource AppCaptionTextStyle}"
                    Text="{x:Bind ValueText}"
                    TextAlignment="Right" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    FontFamily="Consolas"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource AppCaptionTextStyle}"
                    Text="{x:Bind ReferenceLineText}"
                    TextAlignment="Right"
                    Visibility="{x:Bind ReferenceLineVisibility}" />
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Два источника рядом и порознь: снимок борта и эталон. Раскладка,
            показанная без указания, чья она, бесполезна — по ней нельзя
            сказать, читаешь ты изделие или требование к нему.
        -->
        <Border
            Padding="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    Кнопки чтения здесь нет намеренно: таблицу снимает
                    подключение к борту, целиком и один раз. Собственная кнопка
                    означала бы второй опрос той же платы — два снимка разного
                    возраста и вопрос «который из них изделие на стенде» без
                    ответа.
                -->
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource AppBodyStrongTextStyle}" Text="Борт" />
                    <TextBlock
                        x:Name="BoardStateText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="Таблица параметров не читалась: подключите борт на экране «Стенд»."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Style="{StaticResource AppBodyStrongTextStyle}" Text="Эталон" />
                    <ComboBox
                        x:Name="ReferenceBox"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="эталон не выбран"
                        SelectionChanged="OnReferenceChanged" />
                    <TextBlock
                        x:Name="ReferenceStateText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="Без эталона показывается только снимок борта: сверять не с чем."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar
            x:Name="PageBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False" />

        <!--
            Вкладки экранов. Их число берётся из имён параметров, а не
            назначается равным четырём: у прошивки с наложением по MSP экранов
            бывает больше, а на плате без OSD — ни одного, и вкладка,
            нарисованная по договорённости, показывала бы пустой экран как
            существующий.
        -->
        <SelectorBar
            x:Name="ScreenSelector"
            Grid.Row="2"
            SelectionChanged="OnScreenChanged" />

        <Grid Grid.Row="3">
            <!--  Общие настройки подсистемы: одна колонка на всю ширину.  -->
            <Border
                x:Name="GeneralPanel"
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource AppBodyStrongTextStyle}" Text="Общие настройки OSD" />
                    <TextBlock
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="Имена без номера экрана: они действуют на всю подсистему сразу."
                        TextWrapping="Wrap" />

                    <ListView
                        x:Name="GeneralList"
                        Grid.Row="2"
                        IsItemClickEnabled="False"
                        ItemContainerStyle="{StaticResource RowContainerStyle}"
                        ItemTemplate="{StaticResource OsdValueTemplate}"
                        ItemsSource="{x:Bind GeneralRows}"
                        SelectionMode="None" />
                </Grid>
            </Border>

            <!--  Экран: таблица панелей слева, макет знакового поля справа.  -->
            <Grid x:Name="ScreenPanel" ColumnSpacing="16" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <!--
                        🔴 Сетка, а не стек. В стеке высота списка не ограничена:
                        он растёт вместе с содержимым и не прокручивается вовсе,
                        а панелей на экране до полусотни — нижние стали бы
                        недостижимы. Строка «*» отдаёт списку остаток панели, и
                        прокрутка появляется сама.
                    -->
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="PanelsTitleText"
                            Style="{StaticResource AppBodyStrongTextStyle}"
                            Text="Панели" />

                        <TextBlock
                            x:Name="PanelsSummaryText"
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource AppCaptionTextStyle}"
                            Text=""
                            TextWrapping="Wrap" />

                        <!--  Шапка столбиков: без неё X и Y неотличимы друг от друга.  -->
                        <Grid
                            Grid.Row="2"
                            Margin="10,0"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="14" />
                            <TextBlock
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource AppCaptionTextStyle}"
                                Text="панель" />
                            <TextBlock
                                Grid.Column="2"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource AppCaptionTextStyle}"
                                Text="показ" />
                            <TextBlock
                                Grid.Column="3"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource AppCaptionTextStyle}"
                                Text="X"
                                TextAlignment="Right" />
                            <TextBlock
                                Grid.Column="4"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource AppCaptionTextStyle}"
                                Text="Y"
                                TextAlignment="Right" />
                        </Grid>

                        <ListView
                            x:Name="PanelList"
                            Grid.Row="3"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource RowContainerStyle}"
                            ItemTemplate="{StaticResource OsdPanelTemplate}"
                            ItemsSource="{x:Bind PanelRows}"
                            SelectionMode="None" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource AppBodyStrongTextStyle}" Text="Макет экрана" />
                                <TextBlock
                                    x:Name="MockSizeText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource AppCaptionTextStyle}"
                                    Text="" />
                            </Grid>

                            <!--
                                Знаковое поле. Панель стоит в той клетке, которую
                                задают её X и Y; ширина плашки — длина имени
                                панели, а не длина того, что прошивка нарисует.
                                Сказано об этом вслух ниже: макет показывает
                                привязку, а не кадр с очков, и выдавать одно за
                                другое нельзя.
                            -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid x:Name="MockHost" SizeChanged="OnMockSizeChanged" />
                            </Border>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource AppCaptionTextStyle}"
                                Text="Макет показывает знакоместо привязки панели и её имя, а не то, что прошивка нарисует: ширина настоящей надписи зависит от значения в полёте."
                                TextWrapping="Wrap" />

                            <TextBlock
                                x:Name="MockNoteText"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Style="{StaticResource AppCaptionTextStyle}"
                                Text=""
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource AppBodyStrongTextStyle}" Text="Настройки экрана" />

                            <ListView
                                x:Name="ScreenSettingsList"
                                Grid.Row="1"
                                IsItemClickEnabled="False"
                                ItemContainerStyle="{StaticResource RowContainerStyle}"
                                ItemTemplate="{StaticResource OsdValueTemplate}"
                                ItemsSource="{x:Bind SettingRows}"
                                SelectionMode="None" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <TextBlock
                x:Name="EmptyText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource AppBodyTextStyle}"
                Text="Подключите борт на экране «Стенд» либо выберите эталон."
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
