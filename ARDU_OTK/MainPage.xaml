<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ARDU_OTK.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ARDU_OTK"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d">

    <Page.Resources>

        <!--  Подсветка снизу: мягкое свечение под активным блоком  -->
        <LinearGradientBrush x:Key="GlowBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#7A16C060" />
            <GradientStop Offset="1" Color="#0016C060" />
        </LinearGradientBrush>

        <!--  Акцент плашки: тот же тон, что у подсветки снизу.  -->
        <SolidColorBrush x:Key="TileAccentBrush" Color="#16C060" />

        <!--  Плашка: вся площадь нажимаемая  -->
        <Style x:Key="TileStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>

        <!--
            Активная плашка: акцентный кант слева. Толщина, а не цвет фона —
            цеховой ПК может стоять в светлой теме, где заливка акцентом душит
            текст, а кант читается в обеих темах одинаково. И это второй признак
            вдобавок к подсветке снизу: по одному только свечению состояние
            читать нельзя.
        -->
        <Style
            x:Key="ActiveTileStyle"
            BasedOn="{StaticResource TileStyle}"
            TargetType="Button">
            <Setter Property="BorderThickness" Value="3,1,1,1" />
            <Setter Property="BorderBrush" Value="{StaticResource TileAccentBrush}" />
        </Style>

        <!--
            Незаполненная панель светится красным. Пустой борт или пустой эталон —
            это не нейтральное состояние ожидания, а незавершённая подготовка, и
            видно это должно быть через весь цех, не приглядываясь.
        -->
        <LinearGradientBrush x:Key="GlowDangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#7AD13438" />
            <GradientStop Offset="1" Color="#00D13438" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="TileDangerBrush" Color="#D13438" />

        <Style
            x:Key="DangerTileStyle"
            BasedOn="{StaticResource TileStyle}"
            TargetType="Button">
            <Setter Property="BorderThickness" Value="3,1,1,1" />
            <Setter Property="BorderBrush" Value="{StaticResource TileDangerBrush}" />
        </Style>

        <!--
            Расхождение по одному параметру. Ожидаемое и фактическое стоят
            рядом и разведены цветом: оператор сверяет их десятками, и
            догадываться, какое из двух чисел эталонное, он не должен.
        -->
        <DataTemplate x:Key="DifferenceTemplate" x:DataType="local:ParameterDifferenceRow">
            <Grid ColumnSpacing="10" Padding="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontFamily="Consolas"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Name}" />
                        <Border
                            Padding="5,0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="3"
                            Visibility="{x:Bind VisibleBadgeVisibility}">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="показываемый" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ExpectedText}" />
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ActualText}" />
                    </StackPanel>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind OutcomeText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind OutcomeVisibility, Mode=OneWay}" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Click="OnWriteOneClick"
                    Content="Записать"
                    IsEnabled="{x:Bind CanWrite, Mode=OneWay}"
                    Tag="{x:Bind Name}"
                    Visibility="{x:Bind WriteButtonVisibility}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MagTemplate" x:DataType="local:CompassRow">
            <Grid Padding="0,4" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="13"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind OkVisibility}" />
                <FontIcon
                    FontSize="13"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="&#xE7BA;"
                    Visibility="{x:Bind WarnVisibility}" />
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Title}" />

                        <!--
                            Метка вида компаса. Внешний, внутренний и «судить
                            нельзя» окрашены по-разному: последнее не должно
                            выглядеть как исправное состояние.
                        -->
                        <Border
                            Padding="6,0"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="3"
                            Visibility="{x:Bind ExternalVisibility}">
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="внешний" />
                        </Border>
                        <Border
                            Padding="6,0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="3"
                            Visibility="{x:Bind InternalVisibility}">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="внутренний" />
                        </Border>
                        <Border
                            Padding="6,0"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="3"
                            Visibility="{x:Bind UnknownKindVisibility}">
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind KindText}" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind DeviceText}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Detail}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind FieldText}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LogTemplate" x:DataType="local:CalibrationLogRow">
            <Grid Padding="0,2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontFamily="Consolas"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind TimeText}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!--
        🔴 Прокрутки у рабочего экрана нет намеренно. Оператор у стенда должен
        видеть приборы, компасы и расхождения одновременно: то, что уехало за
        нижний край, при принятии решения не участвует, а прокручивать экран
        рукой, занятой платой, он не станет. Поэтому окно делится на три
        строки — верх и низ по содержимому, середина забирает остаток, — а
        длинные списки прокручиваются внутри своих панелей.
    -->
    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

            <!--  Верх: борт слева, HUD посредине, эталон справа. Боковые панели равны.  -->
            <Grid ColumnSpacing="16">
                <!--
                    Доли колонок: борт и эталон по 20 %, приборы посередине —
                    остальное. Боковые панели несут по три строки текста, и
                    отданная им треть экрана простаивала бы там, где оператору
                    нужны горизонт и расхождения.
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!--  Полётный контроллер  -->
                <StackPanel x:Name="FcSelector" VerticalAlignment="Top">
                    <TextBlock
                        Margin="2,0,0,6"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Полётный контроллер" />

                    <Button
                        x:Name="PortCard"
                        Click="OnPortCardClick"
                        Style="{StaticResource TileStyle}">
                        <StackPanel>
                            <TextBlock
                                x:Name="PortCardTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Порт не выбран"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="PortCardDetail"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Нажмите, чтобы выбрать"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <!--  Свечение снизу, когда связь есть  -->
                    <Border
                        x:Name="PortGlow"
                        Height="10"
                        Margin="8,0,8,0"
                        Background="{StaticResource GlowBrush}"
                        CornerRadius="0,0,6,6"
                        Visibility="Collapsed" />

                    <!--
                        Раскрытие живёт в Popup: он рисуется поверх окна и не
                        занимает места в разметке, поэтому список не раздвигает
                        остальные панели. Одна плашка уходит вверх, остальные
                        вниз — прозрачная прокладка занимает место карточки.
                    -->
                    <primitives:Popup x:Name="PortPopup" IsLightDismissEnabled="True">
                        <StackPanel x:Name="PortPopupRoot" Spacing="6">
                            <StackPanel x:Name="PortsAbove" Spacing="6" />
                            <Border x:Name="PortSpacer" Background="Transparent" />
                            <ScrollViewer
                                x:Name="PortsBelowScroll"
                                MaxHeight="200"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PortsBelow" Spacing="6" />
                            </ScrollViewer>
                        </StackPanel>
                    </primitives:Popup>

                    <ProgressRing
                        x:Name="LinkRing"
                        Width="18"
                        Height="18"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        IsActive="False" />

                    <CheckBox
                        x:Name="AutoConnectCheck"
                        Margin="0,4,0,0"
                        Click="OnAutoConnectChanged"
                        Content="Подключаться автоматически" />
                </StackPanel>

                <!--  Эталон  -->
                <StackPanel
                    x:Name="ReferenceSelector"
                    Grid.Column="2"
                    VerticalAlignment="Top">
                    <TextBlock
                        Margin="2,0,0,6"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Эталон" />

                    <Button
                        x:Name="ReferenceCard"
                        Click="OnReferenceCardClick"
                        Style="{StaticResource TileStyle}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock
                                    x:Name="ReferenceCardTitle"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Эталон не выбран"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="ReferenceCardDetail"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Нажмите, чтобы выбрать"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!--
                                Карандаш правит текущий эталон и не раскрывает
                                столбец: вложенная кнопка перехватывает указатель,
                                и до внешней плашки нажатие не доходит.
                            -->
                            <Button
                                x:Name="EditReferenceButton"
                                Grid.Column="1"
                                Padding="6"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnEditReferenceClick"
                                ToolTipService.ToolTip="Изменить эталон"
                                Visibility="Collapsed">
                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                            </Button>
                        </Grid>
                    </Button>

                    <Border
                        x:Name="ReferenceGlow"
                        Height="10"
                        Margin="8,0,8,0"
                        Background="{StaticResource GlowBrush}"
                        CornerRadius="0,0,6,6"
                        Visibility="Collapsed" />

                    <!--  Вверх раскрывается действие «Добавить эталон», а не выбор из списка.  -->
                    <primitives:Popup x:Name="ReferencePopup" IsLightDismissEnabled="True">
                        <StackPanel x:Name="ReferencePopupRoot" Spacing="6">
                            <StackPanel x:Name="ReferencesAbove" Spacing="6" />
                            <Border x:Name="ReferenceSpacer" Background="Transparent" />
                            <ScrollViewer
                                x:Name="ReferencesBelowScroll"
                                MaxHeight="200"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ReferencesBelow" Spacing="6" />
                            </ScrollViewer>
                        </StackPanel>
                    </primitives:Popup>
                </StackPanel>

                <!--
                    Посредине: положение борта. Шкала намеренно разрежена —
                    ступени через 10°, подписи с одной стороны, ленты курса нет.
                    В полосе такой ширины плотная символика нечитаема.
                -->
                <Border
                    x:Name="HudCard"
                    Grid.Column="1"
                    Margin="0,20,0,0"
                    Padding="14"
                    VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="14">

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Положение" />

                        <Border
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid x:Name="HudViewport" Height="170" SizeChanged="OnHudSizeChanged">
                                <Grid.Clip>
                                    <RectangleGeometry x:Name="HudClip" />
                                </Grid.Clip>

                                <Canvas x:Name="LadderHost">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="PitchTranslate" />
                                            <RotateTransform x:Name="RollRotate" />
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                </Canvas>

                                <Canvas x:Name="FixedHost" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <!--  Цифры крупно и в одном месте, а не по углам прибора  -->
                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Крен" />
                                <TextBlock
                                    x:Name="HudRollText"
                                    FontFamily="Consolas"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Text="—" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Тангаж" />
                                <TextBlock
                                    x:Name="HudPitchText"
                                    FontFamily="Consolas"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Text="—" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Курс, истинный" />
                                <TextBlock
                                    x:Name="HudYawText"
                                    FontFamily="Consolas"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Text="—" />
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Напряжение" />
                                <TextBlock
                                    x:Name="HudVoltageText"
                                    FontFamily="Consolas"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Text="—" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Ток" />
                                <TextBlock
                                    x:Name="HudCurrentText"
                                    FontFamily="Consolas"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Text="—" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Режим" />
                                <TextBlock
                                    x:Name="HudModeText"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="—"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <!--
                            GPS. Вид решения словом, а не числом: «3» не
                            говорит оператору ничего, а «трёхмерное» говорит.
                            Спутники и геометрия рядом — по одному числу
                            спутников о качестве решения судить нельзя.
                        -->
                        <Border
                            Padding="10,8"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="GPS" />
                                    <TextBlock
                                        x:Name="HudGpsFixText"
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="нет данных" />
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Спутники" />
                                        <TextBlock
                                            x:Name="HudGpsSatsText"
                                            FontFamily="Consolas"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="—" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="HDOP" />
                                        <TextBlock
                                            x:Name="HudGpsHdopText"
                                            FontFamily="Consolas"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="—" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Высота" />
                                        <TextBlock
                                            x:Name="HudGpsAltText"
                                            FontFamily="Consolas"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="—" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    x:Name="HudGpsPositionText"
                                    FontFamily="Consolas"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="координат нет"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            x:Name="HudArmedText"
                            FontWeight="SemiBold"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Нет данных" />
                    </StackPanel>
                </Border>

            </Grid>

            <!--  Ниже: остальные панели. Тянутся на весь остаток окна.  -->
            <Grid
                x:Name="PanelsRow"
                Grid.Row="1"
                ColumnSpacing="16">
                <!--  Те же доли, что и наверху: компасы под бортом, журнал под эталоном.  -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Компасы" />

                            <!--
                                Работа с компасами идёт секундами и с
                                перезагрузками борта. Без движения на панели
                                оператор не отличает «идёт» от «зависло» и
                                дёргает кабель посреди записи приоритетов.
                            -->
                            <StackPanel
                                x:Name="CompassBusyPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="Collapsed">
                                <ProgressRing
                                    x:Name="CompassBusyRing"
                                    Width="14"
                                    Height="14"
                                    IsActive="False" />
                                <TextBlock
                                    x:Name="CompassBusyText"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Модуль поля, мГс. Норма 530, допуск 185…875."
                            TextWrapping="Wrap" />
                        <!--
                            Прокрутка внутри панели, а не разрастание панели:
                            три компаса с подписями выше, чем строка окна на
                            цеховом мониторе с крупным масштабом.
                        -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                            <!--
                                Перестановка очереди компасов показывается
                                движением строк. Список, молча перерисованный в
                                другом порядке, читается как «ничего не
                                изменилось»: оператор не заметит, что первым
                                стал другой датчик, а это и есть главный итог
                                шага.
                            -->
                            <ItemsControl
                                x:Name="CompassList"
                                ItemTemplate="{StaticResource MagTemplate}"
                                ItemsSource="{x:Bind Compasses}">
                                <ItemsControl.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <AddDeleteThemeTransition />
                                        <ReorderThemeTransition />
                                        <ContentThemeTransition />
                                    </TransitionCollection>
                                </ItemsControl.ItemContainerTransitions>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock
                            x:Name="CompassHintText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Сверка с эталоном" />

                        <!--
                            Ход сверки виден числом и полосой. Вычитывание
                            тысячи с лишним параметров занимает секунды, и без
                            движения панель неотличима от повисшей: оператор
                            жмёт «Старт» второй раз посреди чтения.
                        -->
                        <TextBlock
                            x:Name="CompareStateText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Сверка не выполнялась."
                            TextWrapping="Wrap" />

                        <ProgressBar
                            x:Name="CompareProgress"
                            Maximum="1"
                            Minimum="0"
                            Visibility="Collapsed"
                            Value="0" />

                        <!--
                            Бегущая галочка: имя только что принятого параметра.
                            Полоса показывает, что работа идёт, но не показывает,
                            что она идёт по делу — зависшее чтение и чтение
                            мусора выглядят одинаково. По бегущим именам видно,
                            что борт отдаёт свою таблицу.
                        -->
                        <Grid
                            x:Name="CompareTickPanel"
                            ColumnSpacing="8"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                x:Name="CompareTickIcon"
                                FontSize="13"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;">
                                <FontIcon.RenderTransform>
                                    <ScaleTransform x:Name="CompareTickScale" CenterX="7" CenterY="7" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                            <TextBlock
                                x:Name="CompareTickName"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text=""
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="CompareTickCount"
                                Grid.Column="2"
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="" />
                        </Grid>

                        <!--  Счётчики итога: совпало, расходится, вне контроля.  -->
                        <Grid
                            x:Name="CompareCountsPanel"
                            ColumnSpacing="6"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="8,4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="CompareMatchedText"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="0" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="совпало" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="8,4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="CompareDiffText"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="0" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="расходится" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="8,4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="CompareSkippedText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="0" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="вне контроля" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="6" x:Name="CompareActionsPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="WriteAllButton"
                                HorizontalAlignment="Stretch"
                                Click="OnWriteAllClick"
                                Content="Записать все"
                                IsEnabled="False" />
                            <Button
                                x:Name="AcceptDiffButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="OnAcceptDiffClick"
                                Content="Принять как есть"
                                IsEnabled="False" />
                        </Grid>

                        <!--
                            Не прошедший проверку параметр въезжает в список
                            анимацией. Строка, появившаяся мгновенно среди
                            десятка таких же, теряется; движение показывает, что
                            список именно пополнился, и куда смотреть.
                        -->
                        <ListView
                            x:Name="DiffList"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource RowContainerStyle}"
                            ItemTemplate="{StaticResource DifferenceTemplate}"
                            ItemsSource="{x:Bind Differences}"
                            SelectionMode="None">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                    <ReorderThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Журнал операций" />
                            <Button
                                Padding="8,2"
                                HorizontalAlignment="Right"
                                Click="OnClearLogClick"
                                Content="Очистить" />
                        </Grid>
                        <ScrollViewer MaxHeight="200">
                            <ItemsControl ItemTemplate="{StaticResource LogTemplate}" ItemsSource="{x:Bind LogEntries}" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Статусы — в самом низу экрана  -->
            <StackPanel Grid.Row="2" Spacing="6">
                <!--
                    Запуск приёмки. Кнопка мертва, пока нет связи или эталона:
                    что именно мешает, сказано строкой ниже, а не молчанием.
                -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="StartAcceptanceButton"
                        HorizontalAlignment="Stretch"
                        Click="OnStartAcceptanceClick"
                        Content="Старт приёмки"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />

                    <!--
                        Команды оператора. Заблокированы, пока расхождения не
                        разобраны: калибровать борт, конфигурация которого
                        расходится с эталоном, значит подтвердить не то изделие,
                        которое сдаётся.
                    -->
                    <Button
                        x:Name="LevelButton"
                        Grid.Column="1"
                        Click="OnLevelClick"
                        Content="Калибровка уровня"
                        IsEnabled="False" />

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="курс борта, °" />
                    <NumberBox
                        x:Name="HeadingBox"
                        Grid.Column="3"
                        MinWidth="120"
                        VerticalAlignment="Center"
                        Maximum="360"
                        Minimum="0"
                        PlaceholderText="не задан"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact" />

                    <Button
                        x:Name="CompassCalButton"
                        Grid.Column="4"
                        Click="OnCompassCalClick"
                        Content="Калибровка компаса"
                        IsEnabled="False" />

                    <Button
                        x:Name="FinishButton"
                        Grid.Column="5"
                        Click="OnFinishClick"
                        Content="Ребут и проверка"
                        IsEnabled="False" />
                </Grid>
                <InfoBar
                    x:Name="ReadyBar"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational"
                    Title="Готовность" />
                <InfoBar
                    x:Name="LinkBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error"
                    Title="Связь" />
                <InfoBar
                    x:Name="ReferenceBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational"
                    Title="Эталон" />
            </StackPanel>

    </Grid>
</Page>
