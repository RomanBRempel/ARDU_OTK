<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ARDU_OTK.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ARDU_OTK"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d">

    <Page.Resources>

        <!--  Подсветка снизу: мягкое свечение под активным блоком  -->
        <LinearGradientBrush x:Key="GlowBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#7A16C060" />
            <GradientStop Offset="1" Color="#0016C060" />
        </LinearGradientBrush>

        <!--  Акцент плашки: тот же тон, что у подсветки снизу.  -->
        <SolidColorBrush x:Key="TileAccentBrush" Color="#16C060" />

        <!--  Плашка: вся площадь нажимаемая  -->
        <Style x:Key="TileStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>

        <!--
            Активная плашка: акцентный кант слева. Толщина, а не цвет фона —
            цеховой ПК может стоять в светлой теме, где заливка акцентом душит
            текст, а кант читается в обеих темах одинаково. И это второй признак
            вдобавок к подсветке снизу: по одному только свечению состояние
            читать нельзя.
        -->
        <Style
            x:Key="ActiveTileStyle"
            BasedOn="{StaticResource TileStyle}"
            TargetType="Button">
            <Setter Property="BorderThickness" Value="3,1,1,1" />
            <Setter Property="BorderBrush" Value="{StaticResource TileAccentBrush}" />
        </Style>

        <!--
            Незаполненная панель светится красным. Пустой борт или пустой эталон —
            это не нейтральное состояние ожидания, а незавершённая подготовка, и
            видно это должно быть через весь цех, не приглядываясь.
        -->
        <LinearGradientBrush x:Key="GlowDangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#7AD13438" />
            <GradientStop Offset="1" Color="#00D13438" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="TileDangerBrush" Color="#D13438" />

        <!--
            Свечение под строкой списка: слабее панельного, иначе полсотни
            строк подряд превращают список в полосатый ковёр и перестают
            что-либо сообщать.
        -->
        <LinearGradientBrush x:Key="RowGlowOkBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#0016C060" />
            <GradientStop Offset="1" Color="#5516C060" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RowGlowBadBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#00D13438" />
            <GradientStop Offset="1" Color="#66D13438" />
        </LinearGradientBrush>

        <Style
            x:Key="DangerTileStyle"
            BasedOn="{StaticResource TileStyle}"
            TargetType="Button">
            <Setter Property="BorderThickness" Value="3,1,1,1" />
            <Setter Property="BorderBrush" Value="{StaticResource TileDangerBrush}" />
        </Style>

        <!--
            Расхождение по одному параметру. Ожидаемое и фактическое стоят
            рядом и разведены цветом: оператор сверяет их десятками, и
            догадываться, какое из двух чисел эталонное, он не должен.
        -->
        <DataTemplate x:Key="DifferenceTemplate" x:DataType="local:ParameterDifferenceRow">
            <Grid ColumnSpacing="10" Padding="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="14" VerticalAlignment="Center">
                    <FontIcon
                        FontSize="11"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind MatchVisibility}" />
                    <FontIcon
                        FontSize="11"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xEA39;"
                        Visibility="{x:Bind DiffVisibility}" />
                </Grid>

                <!--
                    Свечение снизу, как у панелей: слабое зелёное у совпавших,
                    красное у разошедшихся. Второй признак вдобавок к значку —
                    по нему состояние строки читается боковым зрением, при
                    беглом просмотре полусотни строк.
                -->
                <Border
                    Grid.ColumnSpan="3"
                    Height="3"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource RowGlowOkBrush}"
                    Visibility="{x:Bind MatchVisibility}" />
                <Border
                    Grid.ColumnSpan="3"
                    Height="3"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource RowGlowBadBrush}"
                    Visibility="{x:Bind DiffVisibility}" />

                <!--
                    🔴 Имя и оба значения — колонками, а не текстом подряд.
                    Слова «эталон» и «борт», повторённые в каждой из полусотни
                    строк, вытесняют собой сами числа, ради которых оператор в
                    список и смотрит: их место в заголовке над списком, один
                    раз. Колонки дают ещё и выравнивание — расхождение видно
                    по столбику, не читая.
                -->
                <Grid Grid.Column="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ExpectedText}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ActualText}"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind OutcomeText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind OutcomeVisibility, Mode=OneWay}" />
                </Grid>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Top"
                    Click="OnWriteOneClick"
                    Content="Записать"
                    IsEnabled="{x:Bind CanWrite, Mode=OneWay}"
                    Tag="{x:Bind Name}"
                    Visibility="{x:Bind WriteButtonVisibility}" />
            </Grid>
        </DataTemplate>

        <!--
            Отображаемый параметр: то, что технолог поднял в секцию
            «контроль и показ» настройками эталона. Панель существует затем,
            чтобы его решение было видно при сдаче: раскладка, которую можно
            задать в мастере и нигде не увидеть на рабочем экране, ни на что
            не влияет — оператор о ней не знает.
        -->
        <DataTemplate x:Key="WatchedTemplate" x:DataType="local:WatchedParameterRow">
            <Grid Padding="0,2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="11"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind MatchVisibility}" />
                <FontIcon
                    FontSize="11"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="&#xEA39;"
                    Visibility="{x:Bind DiffVisibility}" />
                <TextBlock
                    Grid.Column="1"
                    FontFamily="Consolas"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    FontFamily="Consolas"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ActualText}" />
            </Grid>
        </DataTemplate>

        <!--
            Скрипт изделия. Стоит своей колонкой рядом с параметрами: это
            другая сущность — файл на карте, а не число, — и действие над ней
            другое: залить или удалить, а не записать значение.
        -->
        <DataTemplate x:Key="ScriptTemplate" x:DataType="local:ScriptDifferenceRow">
            <Grid ColumnSpacing="8" Padding="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="14" VerticalAlignment="Top">
                    <FontIcon
                        FontSize="11"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind MatchVisibility}" />
                    <FontIcon
                        FontSize="11"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xEA39;"
                        Visibility="{x:Bind DiffVisibility}" />
                </Grid>

                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock
                        FontFamily="Consolas"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind FileName}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind KindText}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind OutcomeText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind OutcomeVisibility, Mode=OneWay}" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Top"
                    Click="OnApplyScriptClick"
                    Content="{x:Bind ActionText}"
                    IsEnabled="{x:Bind CanApply, Mode=OneWay}"
                    Tag="{x:Bind Path}"
                    Visibility="{x:Bind ActionVisibility}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MagTemplate" x:DataType="local:CompassRow">
            <Grid Padding="0,4" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="13"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind OkVisibility, Mode=OneWay}" />
                <FontIcon
                    FontSize="13"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="&#xE7BA;"
                    Visibility="{x:Bind WarnVisibility, Mode=OneWay}" />
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Title}" />

                        <!--
                            Метка вида компаса. Внешний, внутренний и «судить
                            нельзя» окрашены по-разному: последнее не должно
                            выглядеть как исправное состояние.
                        -->
                        <Border
                            Padding="6,0"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="3"
                            Visibility="{x:Bind ExternalVisibility, Mode=OneWay}">
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="внешний" />
                        </Border>
                        <Border
                            Padding="6,0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="3"
                            Visibility="{x:Bind InternalVisibility, Mode=OneWay}">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="внутренний" />
                        </Border>
                        <Border
                            Padding="6,0"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="3"
                            Visibility="{x:Bind UnknownKindVisibility, Mode=OneWay}">
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind KindText, Mode=OneWay}" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind DeviceText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Detail, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind FieldText, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LogTemplate" x:DataType="local:CalibrationLogRow">
            <Grid Padding="0,2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontFamily="Consolas"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind TimeText}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!--
        🔴 Прокрутки у рабочего экрана нет намеренно. Оператор у стенда должен
        видеть приборы, компасы и расхождения одновременно: то, что уехало за
        нижний край, при принятии решения не участвует, а прокручивать экран
        рукой, занятой платой, он не станет. Поэтому окно делится на три
        строки — верх и низ по содержимому, середина забирает остаток, — а
        длинные списки прокручиваются внутри своих панелей.
    -->
    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

            <!--  Верх: борт слева, HUD посредине, эталон справа. Боковые панели равны.  -->
            <Grid ColumnSpacing="16">
                <!--
                    Порядок колонок: приборы слева, как в Mission Planner —
                    оператор, пришедший с привычной станции, ищет горизонт в
                    левом верхнем углу. Дальше эталон и борт по 20 %: боковые
                    панели несут по три строки текста, и отданная им треть
                    экрана простаивала бы там, где нужны горизонт и расхождения.
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <!--  Полётный контроллер  -->
                <StackPanel
                    x:Name="FcSelector"
                    Grid.Column="2"
                    VerticalAlignment="Top">
                    <TextBlock
                        Margin="2,0,0,6"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Полётный контроллер" />

                    <Button
                        x:Name="PortCard"
                        Click="OnPortCardClick"
                        Style="{StaticResource TileStyle}">
                        <StackPanel>
                            <TextBlock
                                x:Name="PortCardTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Порт не выбран"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="PortCardDetail"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Нажмите, чтобы выбрать"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <!--  Свечение снизу, когда связь есть  -->
                    <Border
                        x:Name="PortGlow"
                        Height="10"
                        Margin="8,0,8,0"
                        Background="{StaticResource GlowBrush}"
                        CornerRadius="0,0,6,6"
                        Visibility="Collapsed" />

                    <!--
                        Раскрытие живёт в Popup: он рисуется поверх окна и не
                        занимает места в разметке, поэтому список не раздвигает
                        остальные панели. Одна плашка уходит вверх, остальные
                        вниз — прозрачная прокладка занимает место карточки.
                    -->
                    <primitives:Popup x:Name="PortPopup" IsLightDismissEnabled="True">
                        <StackPanel x:Name="PortPopupRoot" Spacing="6">
                            <StackPanel x:Name="PortsAbove" Spacing="6" />
                            <Border x:Name="PortSpacer" Background="Transparent" />
                            <ScrollViewer
                                x:Name="PortsBelowScroll"
                                MaxHeight="200"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PortsBelow" Spacing="6" />
                            </ScrollViewer>
                        </StackPanel>
                    </primitives:Popup>

                    <ProgressRing
                        x:Name="LinkRing"
                        Width="18"
                        Height="18"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        IsActive="False" />

                    <CheckBox
                        x:Name="AutoConnectCheck"
                        Margin="0,4,0,0"
                        Click="OnAutoConnectChanged"
                        Content="Подключаться автоматически" />
                </StackPanel>

                <!--  Эталон  -->
                <StackPanel
                    x:Name="ReferenceSelector"
                    Grid.Column="1"
                    VerticalAlignment="Top">
                    <TextBlock
                        Margin="2,0,0,6"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Эталон" />

                    <Button
                        x:Name="ReferenceCard"
                        Click="OnReferenceCardClick"
                        Style="{StaticResource TileStyle}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock
                                    x:Name="ReferenceCardTitle"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Эталон не выбран"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="ReferenceCardDetail"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Нажмите, чтобы выбрать"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!--
                                Карандаш правит текущий эталон и не раскрывает
                                столбец: вложенная кнопка перехватывает указатель,
                                и до внешней плашки нажатие не доходит.
                            -->
                            <Button
                                x:Name="EditReferenceButton"
                                Grid.Column="1"
                                Padding="6"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnEditReferenceClick"
                                ToolTipService.ToolTip="Изменить эталон"
                                Visibility="Collapsed">
                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                            </Button>
                        </Grid>
                    </Button>

                    <Border
                        x:Name="ReferenceGlow"
                        Height="10"
                        Margin="8,0,8,0"
                        Background="{StaticResource GlowBrush}"
                        CornerRadius="0,0,6,6"
                        Visibility="Collapsed" />

                    <!--  Вверх раскрывается действие «Добавить эталон», а не выбор из списка.  -->
                    <primitives:Popup x:Name="ReferencePopup" IsLightDismissEnabled="True">
                        <StackPanel x:Name="ReferencePopupRoot" Spacing="6">
                            <StackPanel x:Name="ReferencesAbove" Spacing="6" />
                            <Border x:Name="ReferenceSpacer" Background="Transparent" />
                            <ScrollViewer
                                x:Name="ReferencesBelowScroll"
                                MaxHeight="200"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ReferencesBelow" Spacing="6" />
                            </ScrollViewer>
                        </StackPanel>
                    </primitives:Popup>
                </StackPanel>

                <!--
                    Посредине: положение борта. Шкала намеренно разрежена —
                    ступени через 10°, подписи с одной стороны, ленты курса нет.
                    В полосе такой ширины плотная символика нечитаема.
                -->
                <Border
                    x:Name="HudCard"
                    Margin="0,20,0,0"
                    Padding="14"
                    VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <!--
                        🔴 Приборка компактная: прибор вдвое ниже, цифры стоят
                        справа от него, а не под ним. Прибор нужен для беглого
                        взгляда «стоит ровно или нет» — на это хватает полосы
                        вдвое ниже, а освободившаяся высота уходит списку
                        расхождений, ради которого экран и открыт.
                    -->
                    <StackPanel Spacing="8">

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Положение" />

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                        <Border
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid x:Name="HudViewport" Height="86" SizeChanged="OnHudSizeChanged">
                                <Grid.Clip>
                                    <RectangleGeometry x:Name="HudClip" />
                                </Grid.Clip>

                                <Canvas x:Name="LadderHost">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="PitchTranslate" />
                                            <RotateTransform x:Name="RollRotate" />
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                </Canvas>

                                <Canvas x:Name="FixedHost" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <!--  Цифры крупно и в одном месте, а не по углам прибора  -->
                        <Grid
                            Grid.Column="1"
                            MinWidth="330"
                            VerticalAlignment="Center"
                            ColumnSpacing="14"
                            RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Крен" />
                                <TextBlock
                                    x:Name="HudRollText"
                                    FontFamily="Consolas"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="—" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Тангаж" />
                                <TextBlock
                                    x:Name="HudPitchText"
                                    FontFamily="Consolas"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="—" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Курс, истинный" />
                                <TextBlock
                                    x:Name="HudYawText"
                                    FontFamily="Consolas"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="—" />
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Напряжение" />
                                <TextBlock
                                    x:Name="HudVoltageText"
                                    FontFamily="Consolas"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="—" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Ток" />
                                <TextBlock
                                    x:Name="HudCurrentText"
                                    FontFamily="Consolas"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="—" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Режим" />
                                <TextBlock
                                    x:Name="HudModeText"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="—"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        </Grid>

                        <!--
                            GPS. Вид решения словом, а не числом: «3» не
                            говорит оператору ничего, а «трёхмерное» говорит.
                            Спутники и геометрия рядом — по одному числу
                            спутников о качестве решения судить нельзя.
                        -->
                        <Border
                            Padding="10,6"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <StackPanel Spacing="2">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="GPS" />
                                    <TextBlock
                                        x:Name="HudGpsFixText"
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="нет данных" />
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Спутники" />
                                        <TextBlock
                                            x:Name="HudGpsSatsText"
                                            FontFamily="Consolas"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="—" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="HDOP" />
                                        <TextBlock
                                            x:Name="HudGpsHdopText"
                                            FontFamily="Consolas"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="—" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Высота" />
                                        <TextBlock
                                            x:Name="HudGpsAltText"
                                            FontFamily="Consolas"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="—" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    x:Name="HudGpsPositionText"
                                    FontFamily="Consolas"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="координат нет"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            x:Name="HudArmedText"
                            FontWeight="SemiBold"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Нет данных" />
                    </StackPanel>
                </Border>

            </Grid>

            <!--  Ниже: остальные панели. Тянутся на весь остаток окна.  -->
            <Grid
                x:Name="PanelsRow"
                Grid.Row="1"
                ColumnSpacing="16">
                <!--
                    Те же доли и тот же порядок, что наверху: сверка под
                    приборами, журнал под эталоном, компасы под бортом. Панель
                    под своим источником — иначе оператор ищет компасы под
                    приборами, а находит журнал.
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="2"
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Компасы" />

                            <!--
                                Работа с компасами идёт секундами и с
                                перезагрузками борта. Без движения на панели
                                оператор не отличает «идёт» от «зависло» и
                                дёргает кабель посреди записи приоритетов.
                            -->
                            <StackPanel
                                x:Name="CompassBusyPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="Collapsed">
                                <ProgressRing
                                    x:Name="CompassBusyRing"
                                    Width="14"
                                    Height="14"
                                    IsActive="False" />
                                <TextBlock
                                    x:Name="CompassBusyText"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Модуль поля, мГс. Норма 530, допуск 185…875."
                            TextWrapping="Wrap" />
                        <!--
                            Прокрутка внутри панели, а не разрастание панели:
                            три компаса с подписями выше, чем строка окна на
                            цеховом мониторе с крупным масштабом.
                        -->
                        <!--
                            🔴 Высота ограничена. Без потолка список компасов
                            занимает всю колонку, строка под ним сжимается в
                            ноль, и панель отображаемых параметров пропадает с
                            экрана — не скрытая, а выдавленная за его край.
                        -->
                        <ScrollViewer
                            MaxHeight="200"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Auto">
                            <!--
                                Перестановка очереди компасов показывается
                                движением строк. Список, молча перерисованный в
                                другом порядке, читается как «ничего не
                                изменилось»: оператор не заметит, что первым
                                стал другой датчик, а это и есть главный итог
                                шага.
                            -->
                            <ItemsControl
                                x:Name="CompassList"
                                ItemTemplate="{StaticResource MagTemplate}"
                                ItemsSource="{x:Bind Compasses}">
                                <ItemsControl.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <AddDeleteThemeTransition />
                                        <ReorderThemeTransition />
                                    </TransitionCollection>
                                </ItemsControl.ItemContainerTransitions>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock
                            x:Name="CompassHintText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <!--
                        🔴 Сетка, а не вертикальный стек. В стеке у списка
                        высота не ограничена: он растёт вместе с содержимым и
                        не прокручивается вовсе, поэтому до нижних расхождений
                        добраться нечем. Строка «*» задаёт ему остаток панели,
                        и прокрутка появляется сама.
                    -->
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Сверка с эталоном" />

                        <!--
                            Ход сверки виден числом и полосой. Вычитывание
                            тысячи с лишним параметров занимает секунды, и без
                            движения панель неотличима от повисшей: оператор
                            жмёт «Старт» второй раз посреди чтения.
                        -->
                        <TextBlock
                            x:Name="CompareStateText"
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Сверка не выполнялась."
                            TextWrapping="Wrap" />

                        <ProgressBar
                            x:Name="CompareProgress"
                            Grid.Row="2"
                            Maximum="1"
                            Minimum="0"
                            Visibility="Collapsed"
                            Value="0" />

                        <!--
                            Бегущая галочка: имя только что принятого параметра.
                            Полоса показывает, что работа идёт, но не показывает,
                            что она идёт по делу — зависшее чтение и чтение
                            мусора выглядят одинаково. По бегущим именам видно,
                            что борт отдаёт свою таблицу.
                        -->
                        <Grid
                            x:Name="CompareTickPanel"
                            Grid.Row="3"
                            ColumnSpacing="8"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                x:Name="CompareTickIcon"
                                FontSize="13"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;">
                                <FontIcon.RenderTransform>
                                    <ScaleTransform x:Name="CompareTickScale" CenterX="7" CenterY="7" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                            <TextBlock
                                x:Name="CompareTickName"
                                Grid.Column="1"
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text=""
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="CompareTickCount"
                                Grid.Column="2"
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="" />
                        </Grid>

                        <!--  Счётчики итога: совпало, расходится, вне контроля.  -->
                        <Grid
                            x:Name="CompareCountsPanel"
                            Grid.Row="4"
                            ColumnSpacing="6"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="8,4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="CompareMatchedText"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="0" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="совпало" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="8,4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="CompareDiffText"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="0" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="расходится" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="8,4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="CompareSkippedText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="0" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="вне контроля" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="5" ColumnSpacing="6" x:Name="CompareActionsPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="WriteAllButton"
                                HorizontalAlignment="Stretch"
                                Click="OnWriteAllClick"
                                Content="Записать все"
                                IsEnabled="False" />
                            <Button
                                x:Name="AcceptDiffButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="OnAcceptDiffClick"
                                Content="Принять как есть"
                                IsEnabled="False" />
                        </Grid>

                        <!--
                            Не прошедший проверку параметр въезжает в список
                            анимацией: строка, появившаяся мгновенно среди
                            десятка таких же, теряется, а движение показывает,
                            что список пополнился, и куда смотреть.

                            🔴 Один список, без деления. Совпавшие наблюдаемые
                            имена и расхождения — две стороны одного вопроса
                            «сходится ли борт с эталоном». Разнесённые по
                            разным спискам, они заставляют сверять их памятью:
                            оператор смотрит на расхождения, потом ищет
                            глазами, что там с наблюдаемыми, и обратно.
                        -->
                        <Grid Grid.Row="6" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                Margin="24,0,0,0"
                                VerticalAlignment="Top"
                                ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="параметр" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="эталон"
                                    TextAlignment="Right" />
                                <TextBlock
                                    Grid.Column="2"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="борт"
                                    TextAlignment="Right" />
                            </Grid>

                            <ListView
                                x:Name="DiffList"
                                Margin="0,22,0,0"
                                IsItemClickEnabled="False"
                                ItemContainerStyle="{StaticResource RowContainerStyle}"
                                ItemTemplate="{StaticResource DifferenceTemplate}"
                                ItemsSource="{x:Bind Differences}"
                                SelectionMode="None">
                                <ListView.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <AddDeleteThemeTransition />
                                        <ReorderThemeTransition />
                                    </TransitionCollection>
                                </ListView.ItemContainerTransitions>
                            </ListView>

            <!--
                                Скрипты — своей панелью справа от сравнения
                                параметров. Отдельной, потому что это другая
                                сущность: файл на карте, а не число, и действие
                                над ней другое — залить или удалить. Рядом, а
                                не под: прошивка исполняет всё, что лежит в
                                каталоге скриптов, и лишний файл делает изделие
                                непохожим на эталонное при полностью совпавших
                                параметрах.
                            -->
                            <Border
                                Grid.Column="1"
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Скрипты" />
                                    <Button
                                        x:Name="ApplyAllScriptsButton"
                                        Grid.Column="1"
                                        Click="OnApplyAllScriptsClick"
                                        Content="Привести к эталону"
                                        IsEnabled="False" />
                                </Grid>

                                <TextBlock
                                    x:Name="ScriptsStateText"
                                    Grid.Row="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Сверка скриптов не выполнялась."
                                    TextWrapping="Wrap" />

                                <ListView
                                    x:Name="ScriptList"
                                    Grid.Row="2"
                                    IsItemClickEnabled="False"
                                    ItemContainerStyle="{StaticResource RowContainerStyle}"
                                    ItemTemplate="{StaticResource ScriptTemplate}"
                                    ItemsSource="{x:Bind ScriptDiffs}"
                                    SelectionMode="None">
                                    <ListView.ItemContainerTransitions>
                                        <TransitionCollection>
                                            <AddDeleteThemeTransition />
                                        </TransitionCollection>
                                    </ListView.ItemContainerTransitions>
                                </ListView>
                            </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Журнал операций" />
                            <Button
                                Padding="8,2"
                                HorizontalAlignment="Right"
                                Click="OnClearLogClick"
                                Content="Очистить" />
                        </Grid>
                        <ScrollViewer MaxHeight="200">
                            <ItemsControl ItemTemplate="{StaticResource LogTemplate}" ItemsSource="{x:Bind LogEntries}" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Статусы — в самом низу экрана  -->
            <StackPanel Grid.Row="2" Spacing="6">
                <!--
                    Запуск приёмки. Кнопка мертва, пока нет связи или эталона:
                    что именно мешает, сказано строкой ниже, а не молчанием.
                -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="StartAcceptanceButton"
                        HorizontalAlignment="Stretch"
                        Click="OnStartAcceptanceClick"
                        Content="Старт приёмки"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />

                    <!--
                        Команды оператора. Заблокированы, пока расхождения не
                        разобраны: калибровать борт, конфигурация которого
                        расходится с эталоном, значит подтвердить не то изделие,
                        которое сдаётся.
                    -->
                    <Button
                        x:Name="LevelButton"
                        Grid.Column="1"
                        Click="OnLevelClick"
                        Content="Калибровка уровня"
                        IsEnabled="False" />

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="курс борта, °" />
                    <NumberBox
                        x:Name="HeadingBox"
                        Grid.Column="3"
                        MinWidth="120"
                        VerticalAlignment="Center"
                        GotFocus="OnHeadingEdited"
                        Maximum="360"
                        Minimum="0"
                        PlaceholderText="с борта"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ToolTipService.ToolTip="Истинный курс борта. Подставляется с борта и следует за ним, пока не тронете поле." />

                    <Button
                        x:Name="CompassCalButton"
                        Grid.Column="4"
                        Click="OnCompassCalClick"
                        Content="Калибровка компаса"
                        IsEnabled="False" />

                    <Button
                        x:Name="FinishButton"
                        Grid.Column="5"
                        Click="OnFinishClick"
                        Content="Ребут и проверка"
                        IsEnabled="False" />
                </Grid>
                <InfoBar
                    x:Name="ReadyBar"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational"
                    Title="Готовность" />
                <InfoBar
                    x:Name="LinkBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error"
                    Title="Связь" />
                <InfoBar
                    x:Name="ReferenceBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational"
                    Title="Эталон" />
            </StackPanel>

    </Grid>
</Page>
