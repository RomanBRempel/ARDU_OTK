<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ARDU_OTK.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ARDU_OTK"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="820"
            Padding="32"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Spacing="20">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Настройки" />

            <!--  Обновления  -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Обновления" />

                    <TextBlock
                        x:Name="VersionText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Версия —" />

                    <InfoBar
                        x:Name="UpdateBar"
                        IsClosable="False"
                        IsOpen="True"
                        Message="Проверка обновлений не выполнялась."
                        Severity="Informational"
                        Title="Состояние" />

                    <ProgressBar
                        x:Name="UpdateProgress"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="UpdateActionButton"
                        Click="OnUpdateActionClick"
                        Content="Проверить обновления" />

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Отсутствие сети — штатная ситуация: приложение продолжает работать без обновлений. Обновление не применяется, пока идёт работа со стендом."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Хранилище  -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Хранилище" />

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Реестр прогонов и эталонные профили лежат вне каталога установки, поэтому переживают обновление."
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="StorePathText"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextWrapping="Wrap" />

                    <InfoBar
                        x:Name="StoreBar"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Error"
                        Title="Реестр" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
