<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ARDU_OTK.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ARDU_OTK"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="820"
            Padding="32"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Spacing="20">

            <TextBlock Style="{StaticResource AppTitleTextStyle}" Text="Настройки" />

            <!--
                Рабочее место идёт первым: без азимута и оператора прогон вообще
                не запускается, а обновления и путь к базе — справочная часть.
            -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource AppSubtitleTextStyle}" Text="Рабочее место" />

                    <InfoBar
                        x:Name="WorkstationBar"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning"
                        Title="Стенд не настроен" />

                    <!--
                        🔴 Координаты нужны калибровке компаса. Команда
                        вычисляет эталонное магнитное поле по всемирной
                        магнитной модели в точке борта, и без координат ей
                        считать не по чему: она отвечает отказом «Mag: no
                        position available». Обычно координаты даёт сам борт из
                        фикса GPS, но в цехе внутри здания фикса не бывает.

                        Это свойство рабочего места, а не изделия: стенд стоит
                        на месте, а борта на нём меняются. Курс борта вводится
                        отдельно, на рабочем экране, потому что он меняется от
                        установки к установке.
                    -->
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource AppBodyStrongTextStyle}" Text="Координаты рабочего места" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                x:Name="StandLatBox"
                                MinWidth="200"
                                Header="Широта, °"
                                Maximum="90"
                                Minimum="-90"
                                PlaceholderText="не задана"
                                SmallChange="0.0001"
                                ValueChanged="OnWorkstationChanged" />
                            <NumberBox
                                x:Name="StandLonBox"
                                Grid.Column="1"
                                MinWidth="200"
                                Header="Долгота, °"
                                Maximum="180"
                                Minimum="-180"
                                PlaceholderText="не задана"
                                SmallChange="0.0001"
                                ValueChanged="OnWorkstationChanged" />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource AppCaptionTextStyle}"
                            Text="Десятичные градусы, север и восток положительные. Достаточно точности до сотых: магнитное склонение на таком расстоянии не меняется. Используются только тогда, когда у борта нет трёхмерного фикса GPS — живой фикс важнее, он вдобавок доказывает, что приёмник на плате исправен."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource AppBodyStrongTextStyle}" Text="Оператор" />
                        <TextBox
                            x:Name="OperatorBox"
                            HorizontalAlignment="Left"
                            MinWidth="260"
                            PlaceholderText="фамилия"
                            TextChanged="OnOperatorChanged" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource AppCaptionTextStyle}"
                            Text="Подставляется в прогон и в подпись заводимых эталонов."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock
                        x:Name="WorkstationSavedText"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text=""
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--
                Вид. Стенд может стоять у большого монитора, где вёрстка,
                рассчитанная на ноутбук, даёт нечитаемо мелкий текст, — а
                системный масштаб Windows задан под другое рабочее место и
                трогать его нельзя.
            -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource AppSubtitleTextStyle}" Text="Вид" />

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource AppBodyStrongTextStyle}" Text="Размер шрифта" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--
                                Готовые ступени, а не ползунок: смена масштаба
                                перестраивает страницу целиком, и при перетаскивании
                                ползунка она пересобиралась бы под курсором на
                                каждом шаге.
                            -->
                            <ComboBox
                                x:Name="FontScaleBox"
                                HorizontalAlignment="Left"
                                MinWidth="220"
                                SelectionChanged="OnFontScaleChanged" />
                            <TextBlock
                                x:Name="FontScaleText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource AppCaptionTextStyle}"
                                Text="" />
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource AppCaptionTextStyle}"
                            Text="Масштабируется весь текст: подписи, кнопки, поля ввода и строки таблиц сверки. Изменение применяется сразу — страница перестраивается. Работающая приёмка при этом не прерывается: связь с бортом живёт вне страницы."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--
                        Тема. Своя, а не системная: настройка Windows на цеховом
                        ПК задана под другую задачу и другого пользователя, и
                        трогать её ради стенда нельзя — ровно как и системный
                        масштаб экрана выше.
                    -->
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource AppBodyStrongTextStyle}" Text="Тема" />
                        <ComboBox
                            x:Name="ThemeBox"
                            HorizontalAlignment="Left"
                            MinWidth="220"
                            SelectionChanged="OnThemeChanged" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource AppCaptionTextStyle}"
                            Text="Тёмная тема нужна там, где стенд стоит в затемнённом помещении: светлый экран во всю стену слепит и мешает смотреть на борт. Применяется при следующем запуске — цвета разбираются один раз, на старте приложения."
                            TextWrapping="Wrap" />

                        <InfoBar
                            x:Name="ThemeRestartBar"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational"
                            Title="Тема изменена">
                            <InfoBar.ActionButton>
                                <Button Click="OnThemeRestartClick" Content="Перезапустить" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Обновления  -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource AppSubtitleTextStyle}" Text="Обновления" />

                    <TextBlock
                        x:Name="VersionText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource AppBodyTextStyle}"
                        Text="Версия —" />

                    <InfoBar
                        x:Name="UpdateBar"
                        IsClosable="False"
                        IsOpen="True"
                        Message="Проверка обновлений не выполнялась."
                        Severity="Informational"
                        Title="Состояние" />

                    <ProgressBar
                        x:Name="UpdateProgress"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="UpdateActionButton"
                        Click="OnUpdateActionClick"
                        Content="Проверить обновления" />

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="Отсутствие сети — штатная ситуация: приложение продолжает работать без обновлений. Обновление не применяется, пока идёт работа со стендом."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Хранилище  -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource AppSubtitleTextStyle}" Text="Хранилище" />

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="Реестр прогонов и эталоны лежат вне каталога установки, поэтому переживают обновление."
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="StorePathText"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource AppBodyTextStyle}"
                        TextWrapping="Wrap" />

                    <InfoBar
                        x:Name="StoreBar"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Error"
                        Title="Реестр" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
