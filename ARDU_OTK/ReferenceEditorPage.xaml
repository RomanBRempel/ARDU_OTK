<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ARDU_OTK.ReferenceEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ARDU_OTK"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>

        <!--
            Слот компаса. Пустой слот и слот с неясной внешностью — разные виды:
            первое законно, второе требует разбирательства, и по одному цвету их
            различать нельзя.
        -->
        <DataTemplate x:Key="SlotTemplate" x:DataType="local:ExpectedCompassSlotRow">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    MinWidth="56"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind SlotText}" />

                <Grid
                    Grid.Column="1"
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center">
                    <FontIcon
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE711;"
                        Visibility="{x:Bind EmptyVisibility}" />
                    <FontIcon
                        FontSize="13"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind PresentVisibility}" />
                    <FontIcon
                        FontSize="13"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE7BA;"
                        Visibility="{x:Bind AmbiguousVisibility}" />
                </Grid>

                <StackPanel Grid.Column="2" Spacing="1">
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind DeviceText}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind KindText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--
            Строка параметра в разделе контроля. Причина стоит под именем, а не
            в подсказке: вопрос «почему это не контролируется» задают, глядя на
            конкретное число, и ответ должен быть виден без наведения мыши.
        -->
        <DataTemplate x:Key="ParameterRoleTemplate" x:DataType="local:ParameterRoleRow">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            FontFamily="Consolas"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}" />
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ValueText}" />
                    </StackPanel>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ReasonText}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind OverrideText}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind OverrideVisibility}" />

                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind HazardText}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind HazardVisibility}" />
                </StackPanel>

                <!--
                    Трёхпозиционный ползунок режима контроля. Деления слева
                    направо: не контролируем — контроль — контроль и показ,
                    по возрастанию внимания к параметру. Подпись под ползунком
                    обязательна: положение кружка само по себе не говорит, что
                    именно выбрано.
                -->
                <StackPanel
                    Grid.Column="1"
                    Width="180"
                    VerticalAlignment="Top">
                    <Slider
                        HorizontalAlignment="Stretch"
                        IsThumbToolTipEnabled="False"
                        Maximum="2"
                        Minimum="0"
                        SmallChange="1"
                        SnapsTo="Ticks"
                        StepFrequency="1"
                        Tag="{x:Bind Name}"
                        TickFrequency="1"
                        TickPlacement="Outside"
                        ValueChanged="OnRoleSliderChanged"
                        Value="{x:Bind SliderIndex}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ModeText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--  Скрипт изделия: путь, размер, хеш и врезка первых строк.  -->
        <DataTemplate x:Key="ReferenceScriptTemplate" x:DataType="local:ReferenceScriptRow">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock
                        FontFamily="Consolas"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind FileName}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind DetailText}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind PreviewText}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Click="OnRemoveScriptClick"
                    Content="Убрать"
                    Tag="{x:Bind Path}"
                    Visibility="{x:Bind RemoveVisibility}" />
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid Padding="24">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel
                MaxWidth="860"
                HorizontalAlignment="Stretch"
                Spacing="16">

                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="PageTitle"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Новый эталон изделия" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Эталон хранит постоянную часть технологической карты: параметры образцового изделия, ожидаемый состав компасов и допуски приёмки. Азимут стапеля в эталон не входит — это свойство рабочего места."
                        TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar
                    x:Name="WiringBar"
                    IsClosable="False"
                    IsOpen="False"
                    Message="Реестр не подключён приложением: сохранить эталон невозможно. Это сбой сборки, а не действие оператора."
                    Severity="Error"
                    Title="Реестр не подключён" />

                <InfoBar
                    x:Name="ErrorBar"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error"
                    Title="Ошибка" />

                <InfoBar
                    x:Name="FrozenBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational"
                    Title="Эталон в обращении" />

                <!--  1. Название  -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="1. Название" />

                        <StackPanel Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Имя эталона" />
                            <TextBox
                                x:Name="NameBox"
                                PlaceholderText="например, Гриф-2 ревизия B"
                                TextChanged="OnFormFieldChanged" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Имена сравниваются без учёта регистра и лишних пробелов: два эталона-двойника развели бы историю сдачи по разным записям."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Описание (необязательно)" />
                            <TextBox
                                x:Name="DescriptionBox"
                                AcceptsReturn="True"
                                MaxHeight="90"
                                PlaceholderText="чем эта ревизия отличается"
                                TextChanged="OnFormFieldChanged"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="AuthorPanel" Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Кто заводит эталон" />
                            <TextBox
                                x:Name="AuthorBox"
                                PlaceholderText="фамилия"
                                TextChanged="OnFormFieldChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  2. Эталон  -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="2. Эталон" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="ReferencePathBox"
                                IsReadOnly="True"
                                PlaceholderText="эталон не задан" />
                            <Button
                                x:Name="BrowseButton"
                                Grid.Column="1"
                                Click="OnBrowseClick"
                                Content="Из файла…" />
                            <Button
                                x:Name="SnapshotButton"
                                Grid.Column="2"
                                Click="OnSnapshotClick"
                                Content="Снять с борта" />
                        </Grid>

                        <StackPanel
                            x:Name="SnapshotProgressPanel"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="Collapsed">
                            <ProgressRing
                                x:Name="SnapshotRing"
                                Width="16"
                                Height="16"
                                IsActive="False" />
                            <TextBlock
                                x:Name="SnapshotProgressText"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="" />
                        </StackPanel>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Параметры копируются в эталон целиком — из файла или снимком с откалиброванного образца. Дальше эталон от источника не зависит: файл можно удалить, образец убрать со стенда."
                            TextWrapping="Wrap" />

                        <InfoBar
                            x:Name="SnapshotBar"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational"
                            Title="Снимок с борта" />

                        <StackPanel
                            x:Name="ReferenceSummaryPanel"
                            Spacing="6"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="ReferenceSummaryText"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text=""
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="ReferenceHashText"
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text=""
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--
                            Недостача переносимого блока — не отказ, но и не мелочь:
                            набор без COMPASS_DIA* описывает другое изделие, а не
                            почти то же самое, и узнать об этом надо здесь.
                        -->
                        <InfoBar
                            x:Name="MissingCoreBar"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Warning"
                            Title="В эталоне нет части переносимых параметров" />

                        <InfoBar
                            x:Name="MissingMotBar"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational"
                            Title="COMPASS_MOT* в эталоне нет" />
                    </StackPanel>
                </Border>

                <!--  3. Состав компасов  -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="3. Ожидаемый состав компасов" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Выводится из эталона и не хранится отдельно. Перед прогоном с этим составом сверяется борт: расхождение по типу шины, адресу или типу датчика останавливает процедуру."
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="SlotsEmptyText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Выберите эталонный файл — состав компасов появится здесь."
                            TextWrapping="Wrap" />

                        <ListView
                            x:Name="SlotsList"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource RowContainerStyle}"
                            ItemTemplate="{StaticResource SlotTemplate}"
                            ItemsSource="{x:Bind Slots}"
                            SelectionMode="None"
                            Visibility="Collapsed" />

                        <InfoBar
                            x:Name="TopologyBar"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Error"
                            Title="Состав компасов непригоден" />
                    </StackPanel>
                </Border>

                <!--  4. Допуски  -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="4. Допуски приёмки" />

                        <Grid ColumnSpacing="16" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Курс борта против азимута стапеля, ±°" />
                            <NumberBox
                                x:Name="HeadingToleranceBox"
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                LargeChange="1"
                                Maximum="90"
                                Minimum="0.1"
                                SmallChange="0.5"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnToleranceChanged"
                                Value="3" />

                            <TextBlock
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Расхождение курсов между компасами, менее °" />
                            <NumberBox
                                x:Name="SpreadToleranceBox"
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                LargeChange="1"
                                Maximum="90"
                                Minimum="0.1"
                                SmallChange="0.5"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnToleranceChanged"
                                Value="5" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Значения по умолчанию — из технологической карты: ±3° по курсу и менее 5° между компасами."
                                TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel Spacing="4">
                            <ToggleSwitch
                                x:Name="MotorCompToggle"
                                Header="Переносить COMPASS_MOT*"
                                IsOn="True"
                                OffContent="нет"
                                OnContent="да"
                                Toggled="OnFormToggled" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="COMPASS_MOT* — результат CompassMot, он зависит от силовой проводки изделия. Переносить его допустимо только между полностью одинаковыми сборками."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  5. Контроль параметров  -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="5. Контроль параметров" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Часть параметров прошивки не может совпасть с эталоном ни на одной исправной плате: они называют конкретный экземпляр железа либо ведутся самой прошивкой. Такие имена выведены из сверки и переноса — иначе они останавливали бы каждый прогон. Раскладка ниже задаётся технологической картой; отступить от неё можно, но с обоснованием, и после первого сданного прогона она замораживается."
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="RolesEmptyText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Выберите эталон — раскладка контроля появится здесь."
                            TextWrapping="Wrap" />

                        <InfoBar
                            x:Name="RolesBar"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Warning"
                            Title="Отступления от технологической карты" />

                        <!--
                            Три счётчика вместо трёх раздельных списков. С
                            ползунком в строке раздельные списки не работают:
                            переключённая строка обязана была бы перепрыгнуть в
                            соседний раздел и исчезнуть из-под пальца. Поэтому
                            список один, а раскладка видна счётчиками и
                            фильтром по режиму.
                        -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="10,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                                <StackPanel Spacing="1">
                                    <TextBlock
                                        x:Name="RoleCountVisibleText"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="0" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="контроль и показ"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="10,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                                <StackPanel Spacing="1">
                                    <TextBlock
                                        x:Name="RoleCountHiddenText"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="0" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="только контроль"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="10,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                                <StackPanel Spacing="1">
                                    <TextBlock
                                        x:Name="RoleCountOffText"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="0" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="не контролируем"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="8" Visibility="Collapsed" x:Name="RoleFilterPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="RoleFilterBox"
                                PlaceholderText="фильтр по имени, например COMPASS_OFS"
                                TextChanged="OnRoleFilterChanged" />
                            <ComboBox
                                x:Name="RoleModeFilterBox"
                                Grid.Column="1"
                                MinWidth="190"
                                SelectedIndex="0"
                                SelectionChanged="OnRoleModeFilterChanged">
                                <ComboBoxItem Content="все режимы" />
                                <ComboBoxItem Content="контроль и показ" />
                                <ComboBoxItem Content="только контроль" />
                                <ComboBoxItem Content="не контролируем" />
                            </ComboBox>
                        </Grid>

                        <ListView
                            x:Name="RoleList"
                            MaxHeight="460"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource RowContainerStyle}"
                            ItemTemplate="{StaticResource ParameterRoleTemplate}"
                            ItemsSource="{x:Bind RoleRows}"
                            SelectionMode="None" />
                    </StackPanel>
                </Border>

                <!--  6. Скрипты  -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="6. Скрипты изделия" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Прошивка исполняет всё, что лежит в каталоге APM/scripts. Эталон хранит скрипты содержимым, а не ссылкой на файл, и сверяет их с бортом по SHA-256: тот же текст под другим именем — это другой скрипт, а лишний файл на карте исполняется наравне с остальными."
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="ScriptsSummaryText"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Скриптов нет."
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="AddScriptButton"
                                Grid.Column="1"
                                Click="OnAddScriptClick"
                                Content="Из файла…" />
                            <Button
                                x:Name="ReadScriptsButton"
                                Grid.Column="2"
                                Click="OnReadScriptsClick"
                                Content="Снять с борта" />
                        </Grid>

                        <StackPanel
                            x:Name="ScriptsProgressPanel"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="Collapsed">
                            <ProgressRing
                                x:Name="ScriptsRing"
                                Width="16"
                                Height="16"
                                IsActive="False" />
                            <TextBlock
                                x:Name="ScriptsProgressText"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="" />
                        </StackPanel>

                        <InfoBar
                            x:Name="ScriptsBar"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational"
                            Title="Скрипты" />

                        <ListView
                            x:Name="ScriptsList"
                            MaxHeight="320"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource RowContainerStyle}"
                            ItemTemplate="{StaticResource ReferenceScriptTemplate}"
                            ItemsSource="{x:Bind Scripts}"
                            SelectionMode="None" />
                    </StackPanel>
                </Border>

                <!--  Вместо мёртвой кнопки — прямое указание, чего не хватает.  -->
                <InfoBar
                    x:Name="GateBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning"
                    Title="Сохранить пока нельзя" />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    XYFocusKeyboardNavigation="Enabled">
                    <Button
                        x:Name="SaveButton"
                        Click="OnSaveClick"
                        Content="Сохранить эталон"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        x:Name="CancelButton"
                        Click="OnCancelClick"
                        Content="Отмена" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
