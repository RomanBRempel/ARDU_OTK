<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ARDU_OTK.NetworkAdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ARDU_OTK"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="UserRowTemplate" x:DataType="local:NetworkUserRow">
            <StackPanel Padding="0,6" Spacing="2">
                <TextBlock Style="{StaticResource AppBodyStrongTextStyle}" Text="{x:Bind DisplayName}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource AppCaptionTextStyle}"
                    Text="{x:Bind Details}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="980"
            Padding="32"
            Spacing="20">

            <TextBlock Style="{StaticResource AppTitleTextStyle}" Text="Сеть ОТК" />

            <InfoBar
                x:Name="PageBar"
                IsClosable="True"
                IsOpen="False" />

            <!--
                Выпуск пакета — первым: любые правки пользователей и эталонов
                доходят до стендов только с ним, и состояние «правки есть,
                пакет не выпущен» должно бросаться в глаза.
            -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource AppSubtitleTextStyle}" Text="Пакет сети" />
                    <TextBlock
                        x:Name="IssueStateText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="В пакет входят все пользователи и все эталоны этого стенда. Правки доходят до станций только после выпуска. Пакет выкладывается в публичный репозиторий GitHub: он подписан вашим ключом и зашифрован кодом сети."
                        TextWrapping="Wrap" />

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource AppBodyStrongTextStyle}" Text="Код сети" />
                        <TextBox
                            x:Name="NetworkCodeBox"
                            MaxWidth="360"
                            HorizontalAlignment="Left"
                            FontFamily="Consolas"
                            IsReadOnly="True" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource AppCaptionTextStyle}"
                            Text="Сообщите его при установке станции. Станции нужен только код: ни учётной записи GitHub, ни токена."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource AppBodyStrongTextStyle}" Text="Токен GitHub" />
                        <TextBlock
                            x:Name="TokenStateText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource AppCaptionTextStyle}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PasswordBox
                                x:Name="TokenBox"
                                Width="360"
                                PlaceholderText="github_pat_…" />
                            <Button Click="OnSaveTokenClick" Content="Сохранить токен" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource AppCaptionTextStyle}"
                            Text="Fine-grained токен: доступ только к репозиторию ARDU_OTK.Network, право Contents — Read and write. Хранится только на этом компьютере, зашифрованным под вашей учётной записью Windows."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="IssueButton"
                            Click="OnIssueClick"
                            Content="Выпустить пакет сети"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="IssueFileButton"
                            Click="OnIssueFileClick"
                            Content="Выпустить и сохранить в файл…"
                            ToolTipService.ToolTip="Для станций без интернета: файл принимают кнопкой «Принять пакет из файла»" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Style="{StaticResource AppSubtitleTextStyle}" Text="Пользователи" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="OnNewUserClick"
                                Content="Новый пользователь" />
                        </Grid>
                        <ListView
                            x:Name="UsersList"
                            MaxHeight="480"
                            ItemTemplate="{StaticResource UserRowTemplate}"
                            SelectionChanged="OnUserSelected"
                            SelectionMode="Single" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock
                            x:Name="FormTitle"
                            Style="{StaticResource AppSubtitleTextStyle}"
                            Text="Новый пользователь" />
                        <TextBox x:Name="UserLoginBox" Header="Логин" />
                        <TextBox x:Name="UserNameBox" Header="ФИО (так оно попадает в журнал работ)" />
                        <ComboBox
                            x:Name="RoleBox"
                            MinWidth="220"
                            Header="Роль" />
                        <ToggleSwitch
                            x:Name="ActiveSwitch"
                            Header="Учётка действует"
                            IsOn="True" />
                        <PasswordBox x:Name="UserPasswordBox" Header="Новый пароль (пусто — не менять)" />
                        <PasswordBox x:Name="UserPinBox" Header="Новый PIN, только для оператора (пусто — не менять)" />
                        <CheckBox x:Name="ClearPinBox" Content="Снять PIN" />
                        <Button
                            Click="OnSaveUserClick"
                            Content="Сохранить пользователя"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                🔴 Ключ подписи — корень доверия всей сети. Его утрата означает
                выпуск нового приложения и обновление всех стендов, поэтому
                резервная копия здесь, на виду, а не в глубине настроек.
            -->
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource AppSubtitleTextStyle}" Text="Ключ подписи администратора" />
                    <TextBlock
                        x:Name="KeyStateText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <PasswordBox
                        x:Name="BackupPasswordBox"
                        MaxWidth="360"
                        HorizontalAlignment="Left"
                        Header="Пароль резервной копии (не короче 8 знаков)" />
                    <Button Click="OnBackupKeyClick" Content="Сохранить резервную копию ключа…" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="Храните копию отдельно от этого компьютера (не в папке обмена). Без ключа новый пакет сети не выпустить: стенды примут только пакет, подписанный им."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
