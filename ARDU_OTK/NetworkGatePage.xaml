<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ARDU_OTK.NetworkGatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <!--
        Вход в стенд. Пока стенд не принял пакет сети, здесь только подключение
        к сети: работать по местным эталонам под произвольным именем нельзя,
        иначе контроль распространения обходился бы переустановкой приложения.
    -->
    <ScrollViewer>
        <StackPanel
            MaxWidth="560"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="20">

            <TextBlock Style="{StaticResource AppTitleTextStyle}" Text="Сеть ОТК" />

            <InfoBar
                x:Name="GateBar"
                IsClosable="True"
                IsOpen="False" />

            <!--
                🔴 Обновление — до входа. Экран входа закрывает всё приложение,
                и проверка обновлений, оставленная за ним (в настройках),
                запирала станцию навсегда: ошибку в самом экране входа нечем
                было бы исправить, кроме ручной переустановки на каждой станции.
            -->
            <InfoBar
                x:Name="UpdateBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational"
                Title="Есть новая версия">
                <InfoBar.ActionButton>
                    <Button Click="OnUpdateClick" Content="Обновить и перезапустить" />
                </InfoBar.ActionButton>
            </InfoBar>

            <ProgressRing
                x:Name="BusyRing"
                HorizontalAlignment="Left"
                IsActive="True" />

            <!-- Подключение: новая установка ещё не приняла ни одного пакета. -->
            <Border
                x:Name="ConnectPanel"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource AppSubtitleTextStyle}" Text="Подключение стенда" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Стенд ещё не подключён к сети ОТК. Пользователи и эталоны приходят пакетом от администратора через интернет; устанавливать ничего не нужно. Введите код сети — его сообщает администратор."
                        TextWrapping="Wrap" />

                    <TextBox
                        x:Name="CodeBox"
                        Header="Код сети"
                        PlaceholderText="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="OnConnectClick"
                            Content="Подключиться"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Click="OnImportFileClick"
                            Content="Принять пакет из файла…"
                            ToolTipService.ToolTip="Для стенда без интернета: файл пакета приносит администратор" />
                    </StackPanel>

                    <!--
                        🔴 Эталоны станции выносятся до подключения. Экран входа
                        закрывает всё остальное, а эталон, который живёт только
                        на этой станции, должен попасть к администратору, чтобы
                        войти в сеть. Без этой кнопки эталон оказался бы
                        заперт за экраном, который он же и должен пройти.
                    -->
                    <MenuFlyoutSeparator />
                    <TextBlock Style="{StaticResource AppBodyStrongTextStyle}" Text="Эталоны этой станции" />
                    <TextBlock
                        x:Name="LocalReferencesText"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        TextWrapping="Wrap" />
                    <Button Click="OnExportLocalClick" Content="Сохранить эталоны этой станции в файлы…" />

                    <!--
                        Заведение сети — только на компьютере, где лежит ключ
                        подписи администратора. На стенде оператора панели нет:
                        сеть, заведённая без ключа, не могла бы выпустить пакет,
                        который примут остальные.
                    -->
                    <StackPanel
                        x:Name="CreatePanel"
                        Spacing="10"
                        Visibility="Collapsed">
                        <MenuFlyoutSeparator />
                        <TextBlock Style="{StaticResource AppBodyStrongTextStyle}" Text="Новая сеть (компьютер администратора)" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource AppCaptionTextStyle}"
                            Text="Заводится один раз. Вы станете администратором; все эталоны этого стенда войдут в сеть с первым пакетом."
                            TextWrapping="Wrap" />
                        <TextBox x:Name="AdminLoginBox" Header="Логин" />
                        <TextBox x:Name="AdminNameBox" Header="ФИО" />
                        <PasswordBox x:Name="AdminPasswordBox" Header="Пароль (не короче 8 знаков)" />
                        <PasswordBox x:Name="AdminPasswordRepeatBox" Header="Пароль ещё раз" />
                        <Button Click="OnCreateClick" Content="Завести сеть" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Вход: стенд подключён, пользователи — из принятого пакета. -->
            <Border
                x:Name="LoginPanel"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource AppSubtitleTextStyle}" Text="Вход" />
                    <TextBox x:Name="LoginBox" Header="Логин" />
                    <PasswordBox
                        x:Name="SecretBox"
                        Header="Пароль или PIN"
                        KeyDown="OnSecretKeyDown" />
                    <Button
                        x:Name="LoginButton"
                        Click="OnLoginClick"
                        Content="Войти"
                        Style="{StaticResource AccentButtonStyle}" />

                    <MenuFlyoutSeparator />
                    <TextBlock
                        x:Name="NetworkInfoText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        TextWrapping="Wrap" />
                    <Button Click="OnRefreshClick" Content="Проверить обновление пакета" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
