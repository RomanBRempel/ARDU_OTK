<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ARDU_OTK.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ARDU_OTK"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ARDU_OTK"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="ARDU_OTK">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            NavigationView даёт штатный раздел настроек: проверка обновлений
            переехала туда с рабочего экрана.
        -->
        <NavigationView
            x:Name="RootNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="StandItem"
                    Content="Стенд"
                    IsSelected="True"
                    Tag="stand">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--
                    Эталоны — отдельный раздел, а не подпункт рабочего экрана:
                    ими занимается технолог, а не оператор у стенда, и архив
                    выведенных из обращения нужен при разборе рекламаций, когда
                    стенд не работает вовсе.
                -->
                <NavigationViewItem
                    x:Name="ReferencesItem"
                    Content="Эталоны"
                    Tag="references">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--
                    Настройки OSD — свой раздел, а не панель рабочего экрана.
                    Раскладка наложения читается по вкладкам экранов и макету
                    знакового поля, и место под это нужно во всю ширину окна;
                    на экране стенда, где уже стоят приборы, сверка, скрипты и
                    компасы, ей пришлось бы отдать половину площади ради того,
                    на что смотрят не в каждую смену.
                -->
                <NavigationViewItem
                    x:Name="OsdItem"
                    Content="OSD"
                    Tag="osd">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--
                    Журнал приёмок нужен ровно тогда, когда стенд не работает:
                    при разборе рекламации и при вопросе «чем сдавали вот эту
                    плату». Поэтому он отдельный раздел, а не панель рабочего
                    экрана, где показывается только текущий прогон.
                -->
                <NavigationViewItem
                    x:Name="RunsItem"
                    Content="Журнал"
                    Tag="runs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
