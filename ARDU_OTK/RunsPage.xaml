<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ARDU_OTK.RunsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ARDU_OTK"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            Строка прогона. Исход назван словом и подкрашен: «сдан», «не сдан»,
            «прерван», «идёт». Четыре состояния, а не два, — прерванный прогон
            нельзя показывать как проваленный, это разные события.
        -->
        <DataTemplate x:Key="RunRowTemplate" x:DataType="local:RunRow">
            <Grid Padding="0,6" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="110" />
                    <ColumnDefinition Width="Auto" MinWidth="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="120" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{x:Bind VerdictBrush}"
                    Style="{StaticResource AppBodyTextStyle}"
                    Text="{x:Bind VerdictText}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="Consolas"
                        Style="{StaticResource AppBodyStrongTextStyle}"
                        Text="{x:Bind UnitId}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="{x:Bind StartedText}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="{x:Bind ReferenceText}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="{x:Bind DetailText}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource AppCaptionTextStyle}"
                    Text="{x:Bind OperatorText}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource AppTitleTextStyle}" Text="Журнал приёмок" />

        <InfoBar
            x:Name="PageBar"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="UnitFilterBox"
                MinWidth="220"
                PlaceholderText="номер борта — пусто, значит все"
                TextChanged="OnFilterChanged" />

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="OnRefreshClick"
                Content="Обновить" />

            <TextBlock
                x:Name="CountText"
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource AppCaptionTextStyle}"
                Text="" />
        </Grid>

        <!--
            Сводка по исходам. Один прогон в списке ничего не говорит о том,
            как идёт сдача; доля непринятых — говорит.
        -->
        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="10,6"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="4">
                <StackPanel>
                    <TextBlock
                        x:Name="PassedCountText"
                        FontFamily="Consolas"
                        FontSize="{ThemeResource AppNumericFontSize}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Text="0" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="сдано" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Padding="10,6"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="4">
                <StackPanel>
                    <TextBlock
                        x:Name="FailedCountText"
                        FontFamily="Consolas"
                        FontSize="{ThemeResource AppNumericFontSize}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="0" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="не сдано" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="2"
                Padding="10,6"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="4">
                <StackPanel>
                    <TextBlock
                        x:Name="AbortedCountText"
                        FontFamily="Consolas"
                        FontSize="{ThemeResource AppNumericFontSize}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="0" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="прервано" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="3"
                Padding="10,6"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="4">
                <StackPanel>
                    <TextBlock
                        x:Name="UnitsCountText"
                        FontFamily="Consolas"
                        FontSize="{ThemeResource AppNumericFontSize}"
                        FontWeight="SemiBold"
                        Text="0" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource AppCaptionTextStyle}"
                        Text="бортов" />
                </StackPanel>
            </Border>
        </Grid>

        <ListView
            x:Name="RunList"
            Grid.Row="4"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource RowContainerStyle}"
            ItemTemplate="{StaticResource RunRowTemplate}"
            ItemsSource="{x:Bind Rows}"
            SelectionMode="None" />
    </Grid>
</Page>
