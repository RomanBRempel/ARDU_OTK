<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ARDU_OTK.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ARDU_OTK">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <!--
                🔴 Собственные цвета приложения — по одному набору на тему.
                Зелёный «готово» и красный «не заполнено» раньше были заданы
                литералами прямо в разметке рабочего экрана, то есть одним
                значением на обе темы. Подобранные под светлый фон, на тёмном
                они гаснут: #D13438 на почти чёрной карточке даёт контраст
                около 3:1 — цвет виден, а сигнал уже нет. Здесь оба набора
                стоят рядом, и правка одного сразу видна на фоне второго.

                Ключ «Default» — это ТЁМНАЯ тема, а не светлая: так устроены
                словари тем в WinUI (Default / Light / HighContrast). Название
                обманчивое, но менять его нельзя — по нему ищет платформа.

                Тёмные значения ярче и бледнее светлых по той же причине, по
                какой это делает сама WinUI: на тёмном фоне читается светлота,
                а не насыщенность. Красный взят тот же, что у системной кисти
                SystemFillColorCriticalBrush, — значок расхождения и кант
                карточки обязаны быть одного цвета, иначе они читаются как два
                разных признака.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="TileAccentColor">#16C060</Color>
                    <Color x:Key="TileAccentGlowColor">#7A16C060</Color>
                    <Color x:Key="TileAccentGlowFadeColor">#0016C060</Color>
                    <Color x:Key="RowAccentGlowColor">#5516C060</Color>

                    <Color x:Key="TileDangerColor">#D13438</Color>
                    <Color x:Key="TileDangerGlowColor">#7AD13438</Color>
                    <Color x:Key="TileDangerGlowFadeColor">#00D13438</Color>
                    <Color x:Key="RowDangerGlowColor">#66D13438</Color>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Default">
                    <Color x:Key="TileAccentColor">#57DB8E</Color>
                    <Color x:Key="TileAccentGlowColor">#7A57DB8E</Color>
                    <Color x:Key="TileAccentGlowFadeColor">#0057DB8E</Color>
                    <Color x:Key="RowAccentGlowColor">#4457DB8E</Color>

                    <Color x:Key="TileDangerColor">#FF99A4</Color>
                    <Color x:Key="TileDangerGlowColor">#7AFF99A4</Color>
                    <Color x:Key="TileDangerGlowFadeColor">#00FF99A4</Color>
                    <Color x:Key="RowDangerGlowColor">#55FF99A4</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                Размеры шрифтов приложения. Значения здесь — базовые, на
                масштабе 1.0; перед созданием окна их переписывает UiScale.
                Объявлены они всё равно: разметка ссылается на эти ключи, и
                отсутствие любого из них — это отказ разбора страницы, а не
                просто мелкий шрифт.
            -->
            <x:Double x:Key="AppTinyFontSize">11</x:Double>
            <x:Double x:Key="AppCaptionFontSize">12</x:Double>
            <x:Double x:Key="AppSmallFontSize">13</x:Double>
            <x:Double x:Key="AppBodyFontSize">14</x:Double>
            <x:Double x:Key="AppMediumFontSize">16</x:Double>
            <x:Double x:Key="AppNumericFontSize">17</x:Double>
            <x:Double x:Key="AppSubtitleFontSize">20</x:Double>
            <x:Double x:Key="AppTitleFontSize">28</x:Double>

            <!--
                🔴 Собственные стили текста поверх системных. Переопределить
                размер у самих CaptionTextBlockStyle и прочих нельзя: они
                берут его из словаря WinUI, где ссылка разрешается внутри
                этого же словаря, и запись того же ключа в ресурсы приложения
                до них не доходит. Именно поэтому масштабировался только текст
                внутри контролов, а подписи, заголовки и строки таблиц
                оставались прежними.
            -->
            <Style
                x:Key="AppCaptionTextStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppCaptionFontSize}" />
            </Style>

            <Style
                x:Key="AppBodyTextStyle"
                BasedOn="{StaticResource BodyTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppBodyFontSize}" />
            </Style>

            <Style
                x:Key="AppBodyStrongTextStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppBodyFontSize}" />
            </Style>

            <Style
                x:Key="AppSubtitleTextStyle"
                BasedOn="{StaticResource SubtitleTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppSubtitleFontSize}" />
            </Style>

            <Style
                x:Key="AppTitleTextStyle"
                BasedOn="{StaticResource TitleTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="{ThemeResource AppTitleFontSize}" />
            </Style>

            <!--
                Карточка. Только theme-ресурсы: цеховой ПК может стоять в светлой
                теме, а стенд наладчика — в тёмной, и оба вида обязаны читаться.
                Стиль живёт здесь, а не на страницах: две копии одного оформления
                расходятся при первой же правке.
            -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <Style x:Key="RowContainerStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
