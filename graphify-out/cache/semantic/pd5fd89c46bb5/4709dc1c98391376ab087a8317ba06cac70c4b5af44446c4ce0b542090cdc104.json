{"nodes": [{"id": "_github_skills_winui_app_references_controls_layout_and_adaptive_ui_controls_layout_and_adaptive_ui", "label": "Controls, Layout, and Adaptive UI", "file_type": "document", "source_file": ".github/skills/winui-app/references/controls-layout-and-adaptive-ui.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/layout/responsive-design", "captured_at": null, "author": null, "contributor": null}, {"id": "_github_skills_winui_app_references_controls_layout_and_adaptive_ui_built_in_controls_first", "label": "Built-In WinUI Controls First", "file_type": "rationale", "rationale": "Replacing standard controls purely to change appearance costs platform behavior (accessibility, input, theming) that the built-in control already provides for free.", "source_file": ".github/skills/winui-app/references/controls-layout-and-adaptive-ui.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/layout/responsive-design", "captured_at": null, "author": null, "contributor": null}, {"id": "_github_skills_winui_app_references_controls_layout_and_adaptive_ui_commandbar_preference", "label": "CommandBar as Native Command Surface", "file_type": "rationale", "rationale": "A stock CommandBar with its overflow model covers grouped document, formatting, view, and page-level actions; hand-built toolbar rows from Grid/StackPanel/Border only pay off against a verified CommandBar limitation or explicit design requirement.", "source_file": ".github/skills/winui-app/references/controls-layout-and-adaptive-ui.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/basics/navigation-basics", "captured_at": null, "author": null, "contributor": null}, {"id": "_github_skills_winui_app_references_controls_layout_and_adaptive_ui_scroll_ownership", "label": "Explicit Scroll Ownership for Collections", "file_type": "concept", "rationale": "Nesting a scroll-owning GridView inside an outer page ScrollViewer produces a single vertical column or scroll conflicts instead of a horizontal shelf, so one control must be declared the owner of vertical scrolling and, separately, of horizontal shelf scrolling.", "source_file": ".github/skills/winui-app/references/controls-layout-and-adaptive-ui.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/layout/responsive-design", "captured_at": null, "author": null, "contributor": null}, {"id": "_github_skills_winui_app_references_controls_layout_and_adaptive_ui_virtualization_friendly_collections", "label": "Virtualization-Friendly Collection Controls", "file_type": "concept", "source_file": ".github/skills/winui-app/references/controls-layout-and-adaptive-ui.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/layout/responsive-design", "captured_at": null, "author": null, "contributor": null}, {"id": "_github_skills_winui_app_references_controls_layout_and_adaptive_ui_live_filtering_search", "label": "Single Search Field with Live Filtering", "file_type": "rationale", "rationale": "Explicit apply/refresh/mode controls only earn their place when the underlying operation is expensive, remote, asynchronous, or semantically different; for local filtering they are redundant chrome.", "source_file": ".github/skills/winui-app/references/controls-layout-and-adaptive-ui.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/layout/responsive-design", "captured_at": null, "author": null, "contributor": null}, {"id": "_github_skills_winui_app_references_controls_layout_and_adaptive_ui_adaptive_breakpoint_intent", "label": "Explicit Adaptive Breakpoint Intent", "file_type": "concept", "rationale": "Breakpoints are defined by answering when a shelf becomes a stacked list, when a footer drops nonessential controls, and when the page stops being a desktop canvas; effective pixels replace fixed device assumptions.", "source_file": ".github/skills/winui-app/references/controls-layout-and-adaptive-ui.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/layout/responsive-design", "captured_at": null, "author": null, "contributor": null}, {"id": "_github_skills_winui_app_references_controls_layout_and_adaptive_ui_phone_width_layout_plan", "label": "Phone-Width Single-Column Layout Plan", "file_type": "concept", "source_file": ".github/skills/winui-app/references/controls-layout-and-adaptive-ui.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/layout/responsive-design", "captured_at": null, "author": null, "contributor": null}, {"id": "_github_skills_winui_app_references_controls_layout_and_adaptive_ui_redundant_border_removal", "label": "Remove Redundant Outer Section Borders", "file_type": "concept", "rationale": "Fewer layers adapt more cleanly across breakpoints, so redundant surfaces are removed before more adaptive layout rules are added.", "source_file": ".github/skills/winui-app/references/controls-layout-and-adaptive-ui.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/layout/responsive-design", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_github_skills_winui_app_references_controls_layout_and_adaptive_ui_controls_layout_and_adaptive_ui", "target": "_github_skills_winui_app_references_community_toolkit_controls_and_helpers_settingscontrols", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/skills/winui-app/references/controls-layout-and-adaptive-ui.md", "source_location": null, "weight": 1.0}, {"source": "_github_skills_winui_app_references_controls_layout_and_adaptive_ui_controls_layout_and_adaptive_ui", "target": "_github_skills_winui_app_references_controls_layout_and_adaptive_ui_built_in_controls_first", "relation": "references", "confidence": "EXT