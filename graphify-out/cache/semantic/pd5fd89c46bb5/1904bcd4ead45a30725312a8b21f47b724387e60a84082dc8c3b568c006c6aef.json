{"nodes": [{"id": "_github_skills_winui_app_references_shell_navigation_and_windowing_shell_navigation_and_windowing", "label": "Shell, Navigation, and Windowing", "file_type": "document", "source_file": ".github/skills/winui-app/references/shell-navigation-and-windowing.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/basics/navigation-basics", "captured_at": null, "author": null, "contributor": null}, {"id": "_github_skills_winui_app_references_shell_navigation_and_windowing_navigationview_shell", "label": "NavigationView as Functional Shell Chrome", "file_type": "rationale", "rationale": "The nav pane is chrome first: overloading it with every command, or turning it into a branded hero area with logos and taglines, breaks the shell's native feel. Left nav suits several stable destinations, top nav suits few peers with spare width, and shallow workflows should stay document-first.", "source_file": ".github/skills/winui-app/references/shell-navigation-and-windowing.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/basics/navigation-basics", "captured_at": null, "author": null, "contributor": null}, {"id": "_github_skills_winui_app_references_shell_navigation_and_windowing_custom_title_bar", "label": "Custom Title Bar as Functional Chrome", "file_type": "concept", "rationale": "Title bar customization must preserve drag regions, caption button clarity, and light/dark/high-contrast states; branding is secondary to behaving like a Windows title bar.", "source_file": ".github/skills/winui-app/references/shell-navigation-and-windowing.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/basics/titlebar-design", "captured_at": null, "author": null, "contributor": null}, {"id": "_github_skills_winui_app_references_shell_navigation_and_windowing_appwindow_windowing", "label": "AppWindow and Windows App SDK Windowing", "file_type": "concept", "ratio