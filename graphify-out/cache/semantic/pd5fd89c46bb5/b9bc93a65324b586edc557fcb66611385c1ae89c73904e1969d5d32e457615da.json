"source_file": "README.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_run_history", "label": "Per-Board Run History", "file_type": "concept", "source_file": "README.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_deployment_model", "label": "Unpackaged Self-Contained Deployment", "file_type": "rationale", "source_file": "README.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No prerequisites or admin rights on shop-floor PCs; installs to %LocalAppData%\\ARDU_OTK, data kept separately in ARDU_OTK.Data so updates do not touch it."}, {"id": "readme_velopack", "label": "Velopack", "file_type": "concept", "source_file": "README.md", "source_location": "L40", "source_url": "https://velopack.io", "captured_at": null, "author": null, "contributor": null}, {"id": "readme_github_releases", "label": "GitHub Releases (RomanBRempel/ARDU_OTK)", "file_type": "concept", "source_file": "README.md", "source_location": "L40", "source_url": "https://github.com/RomanBRempel/ARDU_OTK", "captured_at": null, "author": null, "contributor": null, "rationale": "Public repo so clients need no token."}, {"id": "readme_smartscreen_unsigned", "label": "Unsigned Installer / SmartScreen", "file_type": "rationale", "source_file": "README.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No signing certificate; SmartScreen appears once per machine. Signing can be added later via vpk --signParams without MSIX."}, {"id": "readme_release_workflow", "label": "release.yml Workflow", "file_type": "concept", "source_file": "README.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_semver_tag", "label": "SemVer Tag Versioning", "file_type": "rationale", "source_file": "README.md", "source_location": "L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Version comes from tag; Velopack uses SemVer to decide which is newer; Directory.Build.props only holds local build value."}, {"id": "readme_directory_build_props", "label": "Directory.Build.props", "file_type": "concept", "source_file": "README.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_update_service", "label": "UpdateService.IsBusy", "file_type": "concept", "source_file": "README.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocks applying updates during a measurement; if stand code does not set the delegate, the stand is always considered free."}, {"id": "readme_local_installer_build", "label": "Local Installer Build (vpk pack)", "file_type": "concept", "source_file": "README.md", "source_location": "L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--packTitle and --icon required so local build matches release; vpk CLI version must match Velopack package version."}, {"id": "readme_otk_network", "label": "OTK Network", "file_type": "concept", "source_file": "README.md", "source_location": "L91", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_network_package", "label": "Network Package (network.otknet)", "file_type": "concept", "source_file": "README.md", "source_location": "L94", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_network_repo", "label": "ARDU_OTK.Network Public Repository (HTTPS)", "file_type": "rationale", "source_file": "README.md", "source_location": "L95", "source_url": "https://github.com/RomanBRempel/ARDU_OTK.Network", "captured_at": null, "author": null, "contributor": null, "rationale": "Points are physically disconnected; stations download the package over HTTPS like updates, with no install, GitHub account or token. Offline stations accept the package from a file."}, {"id": "readme_signature_trust", "label": "Trust by Signature (ECDSA P-256)", "file_type": "rationale", "source_file": "README.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public key compiled into build; whoever writes the file into the repo, the station accepts only an admin-signed package."}, {"id": "readme_network_code_encryption", "label": "Confidentiality by Network Code (AES-256-GCM)", "file_type": "rationale", "source_file": "README.md", "source_location": "L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The package sits in a public repo and contains references and password/PIN hashes, so it is encrypted on top of the signature with a network code given to the station once at connection."}, {"id": "readme_anti_rollback", "label": "Anti-Rollback (monotonic release number)", "file_type": "rationale", "source_file": "README.md", "source_location": "L106", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_network_gate", "label": "Network Gate Screen (network code, login / operator PIN)", "file_type": "concept", "source_file": "README.md", "source_location": "L108", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_network_references_only", "label": "Only Network References on Connected Stand", "file_type": "rationale", "source_file": "README.md", "source_location": "L112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local references archived not deleted; a matching local reference (same name and params) is linked and keeps its run history."}, {"id": "readme_station_reference_export", "label": "Station Reference Export to Network", "file_type": "concept", "source_file": "README.md", "source_location": "L115", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before connecting, a station saves its references to files; admin accepts them and issues a package; after connecting the station links its reference to the network one."}, {"id": "readme_immutable_references", "label": "Immutable Issued References (clone to change)", "file_type": "rationale", "source_file": "README.md", "source_location": "L119", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_logged_in_operator", "label": "Run Operator = Logged-in User", "file_type": "concept", "source_file": "README.md", "source_location": "L121", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_admin_signing_key", "label": "Admin Signing Key (DPAPI, ARDU_OTK.Keys)", "file_type": "concept", "source_file": "README.md", "source_location": "L134", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Losing the key means releasing a new app version with a new public key, hence immediate backup stored away from the admin computer."}, {"id": "readme_github_token", "label": "Admin GitHub Fine-Grained Token", "file_type": "rationale", "source_file": "README.md", "source_location": "L131", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Access only to ARDU_OTK.Network with Contents read/write, DPAPI-encrypted; never compiled into the app because the installer is in public releases."}, {"id": "readme_ardu_otk_shared", "label": "ARDU_OTK.Shared", "file_type": "concept", "source_file": "README.md", "source_location": "L150", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ardu_otk_tests", "label": "ARDU_OTK.Tests", "file_type": "concept", "source_file": "README.md", "source_location": "L151", "so