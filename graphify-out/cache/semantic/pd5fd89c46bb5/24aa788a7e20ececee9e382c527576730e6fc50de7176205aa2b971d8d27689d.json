{"nodes": [{"id": "_github_skills_winui_app_references_styling_theming_materials_and_icons_styling_theming_materials_and_icons", "label": "Styling, Theming, Materials, and Icons", "file_type": "document", "source_file": ".github/skills/winui-app/references/styling-theming-materials-and-icons.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/style/mica", "captured_at": null, "author": null, "contributor": null}, {"id": "_github_skills_winui_app_references_styling_theming_materials_and_icons_theme_resources_over_hardcoded_colors", "label": "Theme Resources Over Hard-Coded Colors", "file_type": "rationale", "rationale": "Hard-coded light-theme colors break dark and high-contrast modes; centralizing brushes, typography, and corner/spacing tokens in shared dictionaries keeps all three themes correct by construction.", "source_file": ".github/skills/winui-app/references/styling-theming-materials-and-icons.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/style/mica", "captured_at": null, "author": null, "contributor": null}, {"id": "_github_skills_winui_app_references_styling_theming_materials_and_icons_mica", "label": "Mica for Long-Lived Base Layers", "file_type": "concept", "source_file": ".github/skills/winui-app/references/styling-theming-materials-and-icons.md", "source_location": null, "source_url": "https://learn.microsoft.com/windows/apps/design/style/mica", "captured_at": null, "author": null, "contributor": null}, {"id": "_github_skills_winui_app_references_styling_theming_materials_and_icons_acrylic", "label": "Acrylic for Transient Surfaces", "file_type": "concept", "rationale": "Acrylic belongs on flyouts, menus, and other light-dismiss surfaces; using it where Mica or a plain theme-aware surface would do is more expensive and less clear.", "source_file": ".github/skills/winui-app/references/styling-theming-materials-and-icons.md", "source_location": null, "source_url": "ht